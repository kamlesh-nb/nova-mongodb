// document — the typed MongoDB document model (SRP: BSON ergonomics, no wire/IO). `Doc` wraps a
// bson.BsonDocument with typed build + read; `Filter` is a fluent query builder that lowers to a BSON
// filter document; `FindOptions` carries projection/sort/skip/limit/batchSize. All pure over BSON, so
// this module has no dependency on the connection and can be unit-gated offline.
import list;
import string;
import serde.bson;
import serde.source;   // the ValueSink trait for @serializable struct -> BSON via serde.dump<T>

// --- Doc: a typed document (read + build) ------------------------------------------------------

pub struct Doc {
    pub bson: bson.BsonDocument,
    init() { self.bson = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() }; }

    // -- build (fluent) --
    pub fn setStr(self: Doc, key: string, v: string): Doc { self.bson.entries.push(bson.entryString(key, v)); return self; }
    pub fn setInt(self: Doc, key: string, v: long): Doc { self.bson.entries.push(bson.entryInt64Val(key, v)); return self; }
    pub fn setDouble(self: Doc, key: string, v: double): Doc { self.bson.entries.push(bson.entryDoubleVal(key, v)); return self; }
    pub fn setBool(self: Doc, key: string, v: bool): Doc { self.bson.entries.push(bson.entryBool(key, if (v) 1 else 0)); return self; }
    pub fn setObjectId(self: Doc, key: string, hex: string): Doc { self.bson.entries.push(bson.entryObjectId(key, hex)); return self; }
    pub fn setDate(self: Doc, key: string, millis: long): Doc { self.bson.entries.push(bson.entryDate(key, millis)); return self; }
    pub fn setDoc(self: Doc, key: string, v: Doc): Doc { self.bson.entries.push(bson.entryDoc(key, bson.serialize(v.bson))); return self; }
    pub fn setNull(self: Doc, key: string): Doc { self.bson.entries.push(bson.entryNull(key)); return self; }

    // -- read (typed, NULL-/missing-/wrong-type-safe: return undefined) --
    pub fn has(self: Doc, key: string): bool { return bson.docFind(self.bson, key) >= 0; }
    pub fn getStr(self: Doc, key: string): string | undefined {
        let i = bson.docFind(self.bson, key);
        if (i < 0 || bson.docGetType(self.bson, i) != 2) { return undefined; }
        return bson.docGetString(self.bson, i);
    }
    pub fn getInt(self: Doc, key: string): long | undefined {
        let i = bson.docFind(self.bson, key);
        if (i < 0) { return undefined; }
        let t = bson.docGetType(self.bson, i);
        if (t != 16 && t != 18) { return undefined; }
        return bson.docGetInt64(self.bson, i);
    }
    pub fn getDouble(self: Doc, key: string): double | undefined {
        let i = bson.docFind(self.bson, key);
        if (i < 0 || bson.docGetType(self.bson, i) != 1) { return undefined; }
        return bson.docGetDouble(self.bson, i);
    }
    pub fn getBool(self: Doc, key: string): bool | undefined {
        let i = bson.docFind(self.bson, key);
        if (i < 0 || bson.docGetType(self.bson, i) != 8) { return undefined; }
        return bson.docGetBool(self.bson, i) != 0;
    }
    pub fn getObjectId(self: Doc, key: string): string | undefined {
        let i = bson.docFind(self.bson, key);
        if (i < 0 || bson.docGetType(self.bson, i) != 7) { return undefined; }
        return bson.docGetObjectId(self.bson, i);
    }
    pub fn getDate(self: Doc, key: string): long | undefined {
        let i = bson.docFind(self.bson, key);
        if (i < 0 || bson.docGetType(self.bson, i) != 9) { return undefined; }
        return bson.docGetDate(self.bson, i);
    }
    pub fn getDoc(self: Doc, key: string): Doc | undefined {
        let i = bson.docFind(self.bson, key);
        if (i < 0 || bson.docGetType(self.bson, i) != 3) { return undefined; }
        return wrapDoc(bson.deserialize(bson.docGetDoc(self.bson, i) as ptr));
    }
    // An array field as a list of typed Values (undefined when absent or not an array).
    pub fn getArray(self: Doc, key: string): List<Value> | undefined {
        let i = bson.docFind(self.bson, key);
        if (i < 0 || bson.docGetType(self.bson, i) != 4) { return undefined; }
        return readValues(bson.deserialize(bson.docGetArray(self.bson, i) as ptr));
    }
    pub fn getDecimal(self: Doc, key: string): decimal | undefined {
        let i = bson.docFind(self.bson, key);
        if (i < 0 || bson.docGetType(self.bson, i) != 19) { return undefined; }
        return bson.docGetDecimal(self.bson, i);
    }
    // Any field as a typed Value (undefined when the key is absent).
    pub fn getValue(self: Doc, key: string): Value | undefined {
        let i = bson.docFind(self.bson, key);
        if (i < 0) { return undefined; }
        return valueAt(self.bson, i);
    }
    pub fn toJson(self: Doc): string { return bson.docToJson(self.bson); }
}

pub fn doc(): Doc { return Doc(); }
pub fn wrapDoc(b: bson.BsonDocument): Doc { let d = Doc(); d.bson = b; return d; }

// --- DTO -> Doc: serialize a @serializable struct straight into a BSON document -------------------

// A ValueSink that writes each field into a BSON document with the RIGHT Mongo types (int64, not the
// int32 the SQL ORM's BsonSink uses). serde.dump<T> drives it, calling one put* per struct field.
pub struct MongoSink impl ValueSink {
    pub d: bson.BsonDocument,
    init() { self.d = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() }; }
    fn putString(self: MongoSink, key: string, val: string): void { self.d.entries.push(bson.entryString(key, val)); }
    fn putInt(self: MongoSink, key: string, val: long): void { self.d.entries.push(bson.entryInt64Val(key, val)); }
    fn putBool(self: MongoSink, key: string, val: bool): void { self.d.entries.push(bson.entryBool(key, if (val) 1 else 0)); }
    fn putFloat(self: MongoSink, key: string, val: double): void { self.d.entries.push(bson.entryDoubleVal(key, val)); }
    fn putDecimal(self: MongoSink, key: string, val: decimal): void { self.d.entries.push(bson.entryDecimal(key, val)); }
}
pub fn newMongoSink(): MongoSink { return MongoSink(); }

// --- Doc -> DTO: read a BSON document back into a @serializable struct via serde.bind<T> --------

// A ValueSource over a Doc, so `serde.bind<T>` can deserialize a fetched Mongo document into a typed
// struct (the read complement of MongoSink). Scalars map to Doc's typed getters; getChild reads a nested
// sub-document; the item* methods walk an array field's typed Values (for List<primitive>/List<struct>).
pub struct DocSource impl ValueSource {
    pub d: Doc,
    init(d: Doc) { self.d = d; }

    pub fn getString(self: DocSource, key: string): string { return self.d.getStr(key) ?? ""; }
    pub fn getInt(self: DocSource, key: string): long { return self.d.getInt(key) ?? 0; }
    pub fn getBool(self: DocSource, key: string): bool { return self.d.getBool(key) ?? false; }
    pub fn getFloat(self: DocSource, key: string): double { return self.d.getDouble(key) ?? 0.0; }
    pub fn getDecimal(self: DocSource, key: string): decimal { return self.d.getDecimal(key) ?? 0m; }
    pub fn getChild(self: DocSource, key: string): ValueSource {
        let c = self.d.getDoc(key);
        return DocSource(c ?? doc());
    }
    pub fn has(self: DocSource, key: string): bool { return self.d.has(key); }
    pub fn arrayLen(self: DocSource, key: string): int {
        let a = self.d.getArray(key);
        if (a != undefined) { return a.size(); }
        return 0;
    }
    pub fn itemString(self: DocSource, key: string, i: int): string {
        let a = self.d.getArray(key);
        if (a != undefined) { let v = a.get(i); if (v != undefined) { return v.asStr() ?? ""; } }
        return "";
    }
    pub fn itemInt(self: DocSource, key: string, i: int): long {
        let a = self.d.getArray(key);
        if (a != undefined) { let v = a.get(i); if (v != undefined) { return v.asInt() ?? 0; } }
        return 0;
    }
    pub fn itemDecimal(self: DocSource, key: string, i: int): decimal {
        let a = self.d.getArray(key);
        if (a != undefined) { let v = a.get(i); if (v != undefined) { return v.asDecimal() ?? 0m; } }
        return 0m;
    }
    pub fn itemChild(self: DocSource, key: string, i: int): ValueSource {
        let a = self.d.getArray(key);
        if (a != undefined) {
            let v = a.get(i);
            if (v != undefined) { let sub = v.asDoc(); if (sub != undefined) { return DocSource(sub); } }
        }
        return DocSource(doc());
    }
}
pub fn docSource(d: Doc): DocSource { return DocSource(d); }

// --- Value: a typed BSON element (for distinct results and array elements) -----------------------

// BSON type tags this Value models (int64 is normalized to V_INT). Unmodelled types read as V_UNKNOWN.
pub const V_UNKNOWN: int = -1;
pub const V_DOUBLE: int = 1;
pub const V_STRING: int = 2;
pub const V_DOC: int = 3;
pub const V_ARRAY: int = 4;
pub const V_OBJECTID: int = 7;
pub const V_BOOL: int = 8;
pub const V_DATE: int = 9;
pub const V_NULL: int = 10;
pub const V_INT: int = 16;
pub const V_DECIMAL: int = 19;

// One typed value pulled out of a BSON array. Typed accessors return `T | undefined` (undefined when the
// value is not of that type), so `distinct`/array reads keep their real types instead of stringifying.
pub struct Value {
    pub kind: int,        // one of V_* (the BSON type tag; int64 tag 18 normalized to V_INT)
    pub s: string,        // string / ObjectId hex; also the raw sub-document/array bytes for V_DOC/V_ARRAY
    pub i: long,          // int / int64 / date millis / bool (0 or 1)
    pub d: double,        // double
    pub dec: decimal,     // decimal128 (V_DECIMAL)
    init(kind: int, s: string, i: long, d: double) { self.kind = kind; self.s = s; self.i = i; self.d = d; self.dec = 0m; }

    pub fn typeTag(self: Value): int { return self.kind; }
    pub fn isNull(self: Value): bool { return self.kind == V_NULL; }
    pub fn asStr(self: Value): string | undefined { if (self.kind == V_STRING) { return self.s; } return undefined; }
    pub fn asInt(self: Value): long | undefined { if (self.kind == V_INT) { return self.i; } return undefined; }
    pub fn asDouble(self: Value): double | undefined { if (self.kind == V_DOUBLE) { return self.d; } return undefined; }
    pub fn asDecimal(self: Value): decimal | undefined { if (self.kind == V_DECIMAL) { return self.dec; } return undefined; }
    pub fn asBool(self: Value): bool | undefined { if (self.kind == V_BOOL) { return self.i != 0; } return undefined; }
    pub fn asObjectId(self: Value): string | undefined { if (self.kind == V_OBJECTID) { return self.s; } return undefined; }
    pub fn asDate(self: Value): long | undefined { if (self.kind == V_DATE) { return self.i; } return undefined; }
    pub fn asDoc(self: Value): Doc | undefined { if (self.kind == V_DOC) { return wrapDoc(bson.deserialize(self.s as ptr)); } return undefined; }
    pub fn asArray(self: Value): List<Value> | undefined { if (self.kind == V_ARRAY) { return readValues(bson.deserialize(self.s as ptr)); } return undefined; }

    // A display string for any kind (numbers/bools rendered; doc/array/binary -> "").
    pub fn toStr(self: Value): string {
        if (self.kind == V_STRING || self.kind == V_OBJECTID) { return self.s; }
        if (self.kind == V_INT || self.kind == V_DATE) { return `${self.i}`; }
        if (self.kind == V_DOUBLE) { return `${self.d}`; }
        if (self.kind == V_DECIMAL) { return `${self.dec}`; }
        if (self.kind == V_BOOL) { return if (self.i != 0) "true" else "false"; }
        if (self.kind == V_NULL) { return "null"; }
        return "";
    }
}

pub fn nullValue(): Value { return Value(V_NULL, "", 0, 0.0); }

// Read the element at index `i` of a BSON array/document as a typed Value.
pub fn valueAt(arr: bson.BsonDocument, i: int): Value {
    let t = bson.docGetType(arr, i);
    if (t == 2) { return Value(V_STRING, bson.docGetString(arr, i), 0, 0.0); }
    if (t == 16 || t == 18) { return Value(V_INT, "", bson.docGetInt64(arr, i), 0.0); }
    if (t == 1) { return Value(V_DOUBLE, "", 0, bson.docGetDouble(arr, i)); }
    if (t == 8) { return Value(V_BOOL, "", bson.docGetBool(arr, i), 0.0); }
    if (t == 7) { return Value(V_OBJECTID, bson.docGetObjectId(arr, i), 0, 0.0); }
    if (t == 9) { return Value(V_DATE, "", bson.docGetDate(arr, i), 0.0); }
    if (t == 3) { return Value(V_DOC, bson.docGetDoc(arr, i), 0, 0.0); }
    if (t == 4) { return Value(V_ARRAY, bson.docGetArray(arr, i), 0, 0.0); }
    if (t == 19) { let v = Value(V_DECIMAL, "", 0, 0.0); v.dec = bson.docGetDecimal(arr, i); return v; }
    if (t == 10) { return Value(V_NULL, "", 0, 0.0); }
    return Value(V_UNKNOWN, "", 0, 0.0);
}

// Read every element of a BSON array/document as typed Values.
pub fn readValues(arr: bson.BsonDocument): List<Value> {
    let out = List<Value>();
    let i = 0;
    while (i < arr.entries.size()) { out.push(valueAt(arr, i)); i = i + 1; }
    return out;
}

// --- Filter: a fluent query builder that lowers to a BSON filter document -----------------------

pub struct Filter {
    pub d: bson.BsonDocument,
    init() { self.d = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() }; }

    // Equality: { field: v }
    pub fn eqStr(self: Filter, field: string, v: string): Filter { self.d.entries.push(bson.entryString(field, v)); return self; }
    pub fn eqInt(self: Filter, field: string, v: long): Filter { self.d.entries.push(bson.entryInt64Val(field, v)); return self; }
    pub fn eqBool(self: Filter, field: string, v: bool): Filter { self.d.entries.push(bson.entryBool(field, if (v) 1 else 0)); return self; }
    pub fn eqObjectId(self: Filter, field: string, hex: string): Filter { self.d.entries.push(bson.entryObjectId(field, hex)); return self; }

    // Comparison: { field: { $op: v } }
    pub fn gtInt(self: Filter, field: string, v: long): Filter { return self.opInt(field, "$gt", v); }
    pub fn gteInt(self: Filter, field: string, v: long): Filter { return self.opInt(field, "$gte", v); }
    pub fn ltInt(self: Filter, field: string, v: long): Filter { return self.opInt(field, "$lt", v); }
    pub fn lteInt(self: Filter, field: string, v: long): Filter { return self.opInt(field, "$lte", v); }
    pub fn neInt(self: Filter, field: string, v: long): Filter { return self.opInt(field, "$ne", v); }
    // { field: { $regex: pattern } } — server-side regex match on a string field.
    pub fn regexStr(self: Filter, field: string, pattern: string): Filter { return self.opStr(field, "$regex", pattern); }

    // { field: { $in: [v0, v1, ...] } }
    pub fn inStr(self: Filter, field: string, vs: List<string>): Filter {
        let arr = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
        let i = 0;
        while (i < vs.size()) { arr.entries.push(bson.entryString(`${i}`, vs.get(i) ?? "")); i = i + 1; }
        let sub = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
        sub.entries.push(bson.entryArray("$in", bson.serialize(arr)));
        self.d.entries.push(bson.entryDoc(field, bson.serialize(sub)));
        return self;
    }

    // Escape hatch: merge an arbitrary Doc's fields into the filter (for operators not yet wrapped).
    pub fn raw(self: Filter, extra: Doc): Filter {
        let i = 0;
        while (i < extra.bson.entries.size()) { self.d.entries.push(extra.bson.entries.at(i)); i = i + 1; }
        return self;
    }

    fn opInt(self: Filter, field: string, op: string, v: long): Filter {
        let sub = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
        sub.entries.push(bson.entryInt64Val(op, v));
        self.d.entries.push(bson.entryDoc(field, bson.serialize(sub)));
        return self;
    }
    fn opStr(self: Filter, field: string, op: string, v: string): Filter {
        let sub = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
        sub.entries.push(bson.entryString(op, v));
        self.d.entries.push(bson.entryDoc(field, bson.serialize(sub)));
        return self;
    }
    pub fn toBson(self: Filter): bson.BsonDocument { return self.d; }
}

pub fn filter(): Filter { return Filter(); }
pub fn all(): Filter { return Filter(); }   // {} matches every document

// --- FindOptions: projection / sort / skip / limit / batchSize ----------------------------------

pub struct FindOptions {
    pub projection: bson.BsonDocument,
    pub sort: bson.BsonDocument,
    pub skip: long,
    pub limit: long,
    pub batchSize: int,
    init() {
        self.projection = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
        self.sort = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
        self.skip = 0;
        self.limit = 0;
        self.batchSize = 101;
    }
    // 1 = ascending, -1 = descending
    pub fn sortAsc(self: FindOptions, field: string): FindOptions { self.sort.entries.push(bson.entryInt(field, 1)); return self; }
    pub fn sortDesc(self: FindOptions, field: string): FindOptions { self.sort.entries.push(bson.entryInt(field, 0 - 1)); return self; }
    pub fn include(self: FindOptions, field: string): FindOptions { self.projection.entries.push(bson.entryInt(field, 1)); return self; }
    pub fn exclude(self: FindOptions, field: string): FindOptions { self.projection.entries.push(bson.entryInt(field, 0)); return self; }
    pub fn withSkip(self: FindOptions, n: long): FindOptions { self.skip = n; return self; }
    pub fn withLimit(self: FindOptions, n: long): FindOptions { self.limit = n; return self; }
    pub fn withBatchSize(self: FindOptions, n: int): FindOptions { self.batchSize = n; return self; }
}

pub fn findOptions(): FindOptions { return FindOptions(); }

// --- Update: a fluent update builder lowering to { $set:{...}, $inc:{...}, $unset:{...} } ---------

pub struct Update {
    pub setDoc: bson.BsonDocument,     // $set fields
    pub incDoc: bson.BsonDocument,     // $inc fields
    pub unsetDoc: bson.BsonDocument,   // $unset fields
    init() {
        self.setDoc = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
        self.incDoc = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
        self.unsetDoc = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
    }
    pub fn setStr(self: Update, field: string, v: string): Update { self.setDoc.entries.push(bson.entryString(field, v)); return self; }
    pub fn setInt(self: Update, field: string, v: long): Update { self.setDoc.entries.push(bson.entryInt64Val(field, v)); return self; }
    pub fn setDouble(self: Update, field: string, v: double): Update { self.setDoc.entries.push(bson.entryDoubleVal(field, v)); return self; }
    pub fn setBool(self: Update, field: string, v: bool): Update { self.setDoc.entries.push(bson.entryBool(field, if (v) 1 else 0)); return self; }
    pub fn incInt(self: Update, field: string, v: long): Update { self.incDoc.entries.push(bson.entryInt64Val(field, v)); return self; }
    pub fn unset(self: Update, field: string): Update { self.unsetDoc.entries.push(bson.entryString(field, "")); return self; }
    pub fn toBson(self: Update): bson.BsonDocument {
        let d = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
        if (self.setDoc.entries.size() > 0) { d.entries.push(bson.entryDoc("$set", bson.serialize(self.setDoc))); }
        if (self.incDoc.entries.size() > 0) { d.entries.push(bson.entryDoc("$inc", bson.serialize(self.incDoc))); }
        if (self.unsetDoc.entries.size() > 0) { d.entries.push(bson.entryDoc("$unset", bson.serialize(self.unsetDoc))); }
        return d;
    }
}

pub fn update(): Update { return Update(); }
