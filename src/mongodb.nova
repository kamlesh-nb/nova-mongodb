// nova-mongodb — a MongoDB driver for Nova, distributed as a PACKAGE.
//
// This module is the SEAM: MongoConnection (impl Connection) + MongoDriver (impl Driver)
// + the connect/handshake/auth orchestration. Every other responsibility lives in its own
// module (SOLID/SRP):
//
//   codec     the OP_MSG wire codec        (encodeOpMsg / decodeOpMsg / frameLength)
//   commands  BSON command builders        (hello/insert/find/saslStart/... + commandError)
//
// Consumers only touch MongoDriver/MongoConnection: `import mongodb; MongoDriver()`.
// It depends only on the Nova standard library (the DB seam + BSON + SCRAM crypto) and is
// consumed via `nova get`. Auth is SCRAM-SHA-256 (RFC 5802/7677) via crypto.scram — the
// payloads ride in BSON binary fields.

import bytes;
import string;
import list;
import serde.bson;
import serde.source;   // ValueSink trait, for serde.dump<T> (DTO struct -> BSON on insert)
import crypto.scram;
import crypto.random;
import net.aio;
import net.asynctls;
import io.file;
import db;
import codec;
import commands;
import document;
import srv;

// ---------------------------------------------------------------------------
// Live socket framing
// ---------------------------------------------------------------------------

// A1 async-first seam: read exactly `n` bytes into a fresh string, parking on each recv.
// Read EXACTLY n bytes, or return "" on a short read (closed / half-open socket). Returning a
// truncated buffer silently let readFrame parse a garbage length off a partial header.
async fn readExact(io: aio.AsyncIO, n: int): string {
    if (n <= 0) { return ""; }
    let buf = bytes.alloc(n);
    let got = 0;
    while (got < n) {
        let r = await io.recvInto((buf + got) as int, n - got);
        if (r <= 0) { bytes.free(buf); return ""; }
        got = got + r;
    }
    return buf as string;
}
// Read a full OP_MSG frame (16-byte header carries messageLength, then the rest). Parks.
// Returns "" if the connection closes mid-frame or the declared length is out of bounds.
async fn readFrame(io: aio.AsyncIO): string {
    let head = await readExact(io, codec.HEADER_LEN);
    if (head.length < codec.HEADER_LEN) { return ""; }               // closed before a full header
    let total = bytes.read_i32(head as ptr, 0);
    if (total < codec.HEADER_LEN || total > 67108864) { return ""; } // bound the alloc (64 MiB ceiling)
    let rest = await readExact(io, total - codec.HEADER_LEN);
    if (total > codec.HEADER_LEN && rest.length < total - codec.HEADER_LEN) { return ""; }  // truncated body
    let full = bytes.alloc(total);
    let i = 0;
    while (i < codec.HEADER_LEN) { bytes.write_byte(full, i, bytes.read_byte(head, i)); i = i + 1; }
    let j = 0;
    while (j < total - codec.HEADER_LEN) { bytes.write_byte(full, codec.HEADER_LEN + j, bytes.read_byte(rest, j)); j = j + 1; }
    return full as string;
}

pub struct MongoConnection impl Connection {
    pub io: aio.AsyncIO,
    pub dbName: string,
    pub nextId: int,
    pub busy: bool,              // concurrency guard: one in-flight request per connection
    pub failed: bool,            // set when connect/auth failed: the connection is dead
    pub failErr: string,         // the failure reason surfaced to the first query/exec
    // P6 topology observability: what the SDAM discovery resolved this connection to.
    pub setName: string,         // the replica-set name the server reports ("" for a standalone)
    pub serverHost: string,      // the host:port we are actually connected to (the selected node)
    pub members: List<string>,   // all replica-set members the primary advertised (host:port)
    // Retryable writes: an implicit session (lsid) + a monotonic txnNumber ride on eligible single-doc
    // writes so a transient failure can be retried once, idempotently (the server dedups by lsid+txnNumber).
    pub retryWrites: bool,       // honour retryable writes (default true; DSN retryWrites=false disables)
    pub implicitLsid: string,    // lazily created implicit-session lsid ("" until first retryable write)
    pub implicitTxn: long,       // monotonic txnNumber for the implicit session
    // SDAM monitoring: the DSN (so the connection can re-discover) + this server's last-seen role.
    pub dsn: string,             // the connection string, kept so a heartbeat can re-run discovery
    pub serverType: string,      // RSPrimary / RSSecondary / RSOther / Standalone / Unknown
    pub wantsPrimary: bool,      // read preference is primary(-preferred): a heartbeat must stay on the primary
    pub monitorRunning: bool,    // a background heartbeat loop is active
    pub heartbeatCount: long,    // number of background heartbeats completed (observability)

    init(io: aio.AsyncIO, dbName: string) {
        self.io = io;
        self.dbName = dbName;
        self.nextId = 1;
        self.busy = false;
        self.failed = false;
        self.failErr = "";
        self.setName = "";
        self.serverHost = "";
        self.members = List<string>();
        self.retryWrites = true;
        self.implicitLsid = "";
        self.implicitTxn = 0;
        self.dsn = "";
        self.serverType = "Unknown";
        self.wantsPrimary = true;
        self.monitorRunning = false;
        self.heartbeatCount = 0;
    }
    // Background SDAM monitor: a detached coroutine that heartbeats this connection every `intervalMs`,
    // keeping serverType / members fresh and auto-healing on a failover WITHOUT any caller action. Use a
    // connection DEDICATED to monitoring (the loop shares its socket, so do not run data ops on it too).
    // Built on aio.delay (a real reactor-timer sleep) + coroStart (a detached coroutine) -- reactor-thread
    // only. stopMonitor() ends the loop after the current beat.
    pub fn startMonitor(self: MongoConnection, intervalMs: int): void {
        if (self.monitorRunning) { return; }
        self.monitorRunning = true;
        coroStart(self.monitorLoop(intervalMs));
    }
    pub fn stopMonitor(self: MongoConnection): void { self.monitorRunning = false; }
    async fn monitorLoop(self: MongoConnection, intervalMs: int): void {
        while (self.monitorRunning) {
            let _ = await self.heartbeat();
            self.heartbeatCount = self.heartbeatCount + 1;
            await aio.delay(intervalMs);
        }
    }
    // SDAM: re-run discovery from the stored DSN and swap this connection over to the (possibly new)
    // read-preference target -- the on-demand half of server monitoring, used when a heartbeat finds the
    // primary has moved or a command reports we are no longer writable. Returns false if no node is usable.
    pub async fn reconnect(self: MongoConnection): bool {
        if (self.dsn == "") { return false; }
        let fresh = await mongoConnectAsync(self.dsn);
        if (fresh.failed) { return false; }
        self.io = fresh.io;              // swap over to the newly selected node's stream
        self.nextId = 1;
        self.busy = false;
        self.failed = false; self.failErr = "";
        self.setName = fresh.setName; self.serverHost = fresh.serverHost; self.members = fresh.members;
        self.serverType = fresh.serverType;
        self.implicitLsid = "";          // the session belongs to the old server; get a fresh one
        return true;
    }
    // SDAM heartbeat: run `hello`, refresh this server's role + the member list, and if we have LOST the
    // primary (we are no longer writable but the server names a different primary), re-discover and
    // reconnect to it. Returns true if the connection is healthy (or was healed) afterwards. This is the
    // per-check step of server monitoring; a background timer that calls it on an interval is a follow-on
    // (Nova has no async sleep primitive yet).
    pub async fn heartbeat(self: MongoConnection): bool {
        let info = parseHello(await self.runCommand(commands.helloCommand(self.dbName)));
        if (!info.ok) { return await self.reconnect(); }   // unreachable -> try to re-discover
        self.setName = info.setName;
        self.members = info.hosts;
        self.serverType = if (info.isPrimary) "RSPrimary"
            else if (info.setName != "" && info.primary != "") "RSSecondary"
            else if (info.setName != "") "RSOther"
            else "Standalone";
        // If we need a primary but this node is no longer one (stepped down / secondary), re-discover from
        // ALL seeds and follow the new primary. We reconnect even when this node cannot yet name the new
        // primary (mid-election, primary == ""), because discovery queries the peers directly; reconnect
        // returns false until an election settles, so the caller keeps retrying.
        if (self.wantsPrimary && !info.isPrimary && info.setName != "") {
            return await self.reconnect();
        }
        return true;
    }
    // Lazily create the implicit session used to tag retryable writes (once per connection). Reuses the
    // server-assigned lsid, trimmed to its declared BSON length (see trimBsonDoc / lsidEntry).
    async fn ensureImplicitSession(self: MongoConnection): void {
        if (self.implicitLsid != "") { return; }
        let reply = await self.runCommand(commands.startSessionCommand());
        let idIdx = bson.docFind(reply, "id");
        if (idIdx >= 0) { self.implicitLsid = trimBsonDoc(bson.docGetDoc(reply, idIdx)); }
    }
    // Next txnNumber for the implicit session (a fresh one per retryable write).
    fn nextImplicitTxn(self: MongoConnection): long { self.implicitTxn = self.implicitTxn + 1; return self.implicitTxn; }
    // Reactive auto-failover: run a command and, if a primary-seeking connection gets a "not primary" /
    // dropped-connection reply, re-discover the new primary and retry ONCE transparently. This heals a
    // stepped-down primary WITHOUT the caller doing anything -- the synchronous complement to the
    // background monitor (retrying on the same, now-secondary socket would just fail again).
    pub async fn runCommandFailover(self: MongoConnection, command: bson.BsonDocument): bson.BsonDocument {
        let reply = await self.runCommand(command);
        if (!self.wantsPrimary) { return reply; }
        if (!isNotPrimaryReply(reply)) { return reply; }
        if (!await self.reconnect()) { return reply; }   // no new primary yet -> surface the original error
        return await self.runCommand(command);            // retry once on the new primary
    }
    // Mark this connection dead (auth failure at connect). The first query/exec returns the reason
    // instead of pretending to be live (auth used to be checked-but-ignored).
    pub fn markFailed(self: MongoConnection, why: string): void { self.failed = true; self.failErr = why; }
    // Record the topology this connection resolved to (SDAM discovery result).
    pub fn setTopology(self: MongoConnection, setName: string, host: string, members: List<string>): void {
        self.setName = setName; self.serverHost = host; self.members = members;
    }

    // The native document API entry point: `conn.database("shop").collection("users").find(...)`.
    pub fn database(self: MongoConnection, name: string): Database { return Database(self, name); }
    // The database named in the DSN (used to connect/auth).
    pub fn defaultDatabase(self: MongoConnection): Database { return Database(self, self.dbName); }

    // Start a server-assigned session (its lsid rides on every command in a transaction). Transactions
    // require a replica set / mongos -- a standalone mongod rejects txnNumber.
    pub async fn startSession(self: MongoConnection): Session {
        let reply = await self.runCommand(commands.startSessionCommand());
        let idIdx = bson.docFind(reply, "id");   // reply.id is the lsid document { id: <uuid binary> }
        let lsid = if (idIdx >= 0) bson.docGetDoc(reply, idIdx) else "";
        // docGetDoc returns the deserialised sub-document buffer, whose reported length can carry a couple
        // of slack bytes past the doc's own BSON length prefix. That is harmless when the bytes are re-fed
        // to deserialize (it honours the prefix), but here the raw bytes are embedded verbatim as `lsid`
        // on every transaction command -- so trim to the declared BSON length or the server rejects it.
        return Session(self, trimBsonDoc(lsid));
    }

    // Send one OP_MSG command and await the reply (the recv parks the coroutine). A failed connection
    // (discovery/auth failure, e.g. a deadConn over a fd -1 stream) returns an empty reply carrying the
    // failure reason -- sending on its dead stream would hit the removed Asio path and abort the process.
    pub async fn runCommand(self: MongoConnection, command: bson.BsonDocument): bson.BsonDocument {
        if (self.failed) {
            let e = commands.newDoc();
            e.entries.push(bson.entryDouble("ok", 0, 0));
            e.entries.push(bson.entryString("errmsg", self.failErr));
            return e;
        }
        let id = self.nextId;
        self.nextId = id + 1;
        let frame = codec.encodeOpMsg(id, command);
        let dummy = await self.io.sendStr(frame);
        return codec.decodeOpMsg(await readFrame(self.io));
    }

    pub async fn authenticate(self: MongoConnection, username: string, password: string, clientNonce: string): bool {
        let c = scram.ScramClient{ username: username, password: password, clientNonce: clientNonce };
        let start = await self.runCommand(commands.saslStartCommand(self.dbName, c.clientFirstMessage()));
        let convIdx = bson.docFind(start, "conversationId");
        let payloadIdx = bson.docFind(start, "payload");
        if (convIdx < 0 || payloadIdx < 0) { return false; }
        let conversationId = bson.docGetInt(start, convIdx);
        let serverFirst = bson.docGetBinary(start, payloadIdx);
        let clientFinal = c.clientFinalMessage(serverFirst);
        let cont = await self.runCommand(commands.saslContinueCommand(self.dbName, conversationId, clientFinal));
        let doneIdx = bson.docFind(cont, "done");
        return doneIdx >= 0 && bson.docGetBool(cont, doneIdx) != 0;
    }

    // `sql` names the collection; this runs a find and returns the cursor.firstBatch documents, each as
    // one "document" text cell holding the document's JSON. (getMore for batches beyond firstBatch is a
    // follow-on; firstBatch covers the common small-result case.)
    pub async fn query(self: MongoConnection, sql: string, params: List<DbValue>): ResultSet {
        // A connection is a single request/response channel; a second concurrent query would interleave
        // frames and corrupt the stream. Refuse re-entry instead (use a pool for concurrency).
        if (self.failed) { return db.errorResult(db.DbError("", self.failErr)); }
        if (self.busy) { return db.errorResult(db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let reply = await self.runCommand(commands.findCommand(self.dbName, sql, commands.newDoc()));
        let rs = ResultSet();
        let err = commands.commandError(reply);   // T1: a failed command ({ok:0, errmsg, code}) no longer reads as success
        if (!err.isEmpty()) { rs.err = err; self.busy = false; return rs; }
        rs.columns.push(Column("document", DbType.Text));

        let cursorIdx = bson.docFind(reply, "cursor");
        if (cursorIdx < 0) { self.busy = false; return rs; }
        let cursorDoc = bson.deserialize(bson.docGetDoc(reply, cursorIdx) as ptr);
        let fbIdx = bson.docFind(cursorDoc, "firstBatch");
        if (fbIdx < 0) { self.busy = false; return rs; }
        // firstBatch is a BSON array (a document keyed "0","1",...); each entry is a result document.
        let fbArray = bson.deserialize(bson.docGetArray(cursorDoc, fbIdx) as ptr);
        let i = 0;
        while (i < fbArray.entries.size()) {
            let d = bson.deserialize(bson.docGetDoc(fbArray, i) as ptr);
            let row = Row();
            row.cells.push(db.dbText(bson.docToJson(d)));
            rs.rows.push(row);
            i = i + 1;
        }
        self.busy = false;
        return rs;
    }

    pub async fn exec(self: MongoConnection, sql: string, params: List<DbValue>): ExecResult {
        if (self.failed) { return errorExec(db.DbError("", self.failErr)); }
        if (self.busy) { return errorExec(db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let reply = await self.runCommand(commands.findCommand(self.dbName, sql, commands.newDoc()));
        let err = commands.commandError(reply);
        if (!err.isEmpty()) { self.busy = false; return errorExec(err); }
        let okIdx = bson.docFind(reply, "ok");
        self.busy = false;
        return ExecResult((if (okIdx >= 0) 1 else 0) as long, "");
    }

    pub fn close(self: MongoConnection): void {
        self.io.close();
    }

    pub fn setTimeout(self, ms: int): int {   // D6 — async per-recv awaited deadline
        return self.io.setTimeout(ms);
    }

    // MongoDB has no SQL prepared statements; the seam's prepare/queryPrepared/execPrepared are
    // emulated by re-running the command (kept for trait conformance — the mongo-native API is
    // runCommand + the find/insert helpers).
    pub async fn prepare(self: MongoConnection, sql: string): int { return 0; }
    pub async fn queryPrepared(self: MongoConnection, stmt: int, params: List<DbValue>): ResultSet {
        return await self.query("", params);
    }
    pub async fn execPrepared(self: MongoConnection, stmt: int, params: List<DbValue>): ExecResult {
        return await self.exec("", params);
    }

    // MongoDB transactions are SESSION-based (startTransaction on an lsid + causal consistency), not the
    // SQL BEGIN/COMMIT/ROLLBACK model. The seam methods are no-ops here (returning ok) so the trait is
    // satisfied; real multi-document transactions are a follow-on requiring session support.
    pub async fn begin(self: MongoConnection): ExecResult { return ExecResult(0, "NOOP"); }
    pub async fn commit(self: MongoConnection): ExecResult { return ExecResult(0, "NOOP"); }
    pub async fn rollback(self: MongoConnection): ExecResult { return ExecResult(0, "NOOP"); }
}

// Pull `key=value` out of a `?a=b&c=d` DSN query string (returns `dflt` if absent).
// Return exactly the leading BSON document from `s`, trimming any allocator slack past the document's
// own 4-byte little-endian length prefix. `docGetDoc` hands back a deserialised sub-document buffer whose
// reported length can exceed the declared BSON length; re-embedding that verbatim (as an lsid) would send
// stray trailing bytes the server rejects. If `s` is shorter than its own prefix claims, it is returned
// unchanged (nothing safe to trim to).
// An embedded-document (type 3) BSON entry that carries `src` as its raw bytes, built so `src` is RETAINED.
// This is the safe way to embed the long-lived `Session.lsid` on every transaction command. `bson.entryDoc`
// takes a `ptr` and stores `ptr as string` -- a NON-retaining view -- so when the sent command document is
// dropped its destructor releases that view, over-releasing and freeing `self.lsid`'s buffer; the next
// command then serialises a dangling buffer (the server reports a corrupt lsid). Storing a `string` param
// straight into `str_val` (exactly as `bson.entryString` does) makes the struct field own a retained
// reference, so the release on drop is balanced and `self.lsid` survives the whole transaction.
fn lsidEntry(src: string): bson.BsonEntry {
    return bson.BsonEntry{ type_id: 3, key: "lsid", str_val: src, int_val: 0, int_val2: 0, dec_val: 0m };
}

fn trimBsonDoc(s: string): string {
    if (s.length < 4) { return s; }
    let n = (s[0] & 255) | ((s[1] & 255) << 8) | ((s[2] & 255) << 16) | ((s[3] & 255) << 24);
    if (n <= 0 || n >= s.length) { return s; }
    let buf = bytes.alloc(n);
    let k = 0;
    while (k < n) { bytes.write_byte(buf, k, s[k] & 255); k = k + 1; }
    return buf as string;
}

// Extract `key`'s value from an SRV TXT options string ("replicaSet=rs0&authSource=admin"); "" if absent.
fn txtOption(opts: string, key: string): string {
    let parts = string.split(opts, "&");
    let i = 0;
    while (i < parts.size()) {
        let p = string.trim(parts.get(i) ?? "");
        i = i + 1;
        let eq = string.indexOf(p, "=");
        if (eq > 0 && string.eql(string.slice(p, 0, eq), key)) { return string.slice(p, eq + 1, p.length); }
    }
    return "";
}

fn dsnParam(dsn: string, key: string, dflt: string): string {
    let needle = key + "=";
    let idx = string.indexOf(dsn, needle);
    if (idx == -1) { return dflt; }
    let rest = string.slice(dsn, idx + needle.length, dsn.length);
    let amp = string.indexOf(rest, "&");
    if (amp == -1) { return rest; }
    return string.slice(rest, 0, amp);
}

// --- P6: replica-set topology (SDAM core), read preference, seed lists ---------------------------

// Read-preference modes (the subset that matters for replica-set node selection).
pub const RP_PRIMARY: int = 0;
pub const RP_PRIMARY_PREFERRED: int = 1;
pub const RP_SECONDARY: int = 2;
pub const RP_SECONDARY_PREFERRED: int = 3;
pub const RP_NEAREST: int = 4;

fn parseReadPref(s: string): int {
    if (string.eql(s, "primaryPreferred")) { return RP_PRIMARY_PREFERRED; }
    if (string.eql(s, "secondary")) { return RP_SECONDARY; }
    if (string.eql(s, "secondaryPreferred")) { return RP_SECONDARY_PREFERRED; }
    if (string.eql(s, "nearest")) { return RP_NEAREST; }
    return RP_PRIMARY;
}

struct HostPort { pub host: string, pub port: int, init(h: string, p: int) { self.host = h; self.port = p; } }

// Split "host:port" (defaulting the port to 27017). Seed lists from a mongodb:// URI and replica-set
// configs advertise host names / IPv4, so a bracketed IPv6 literal is out of scope here.
fn splitHostPort(hp: string): HostPort {
    let c = string.lastIndexOf(hp, ":");
    if (c < 0) { return HostPort(hp, 27017); }
    let pn = string.parseI64(string.slice(hp, c + 1, hp.length));
    return HostPort(string.slice(hp, 0, c), if (pn > 0) pn as int else 27017);
}

// What a `hello` reply tells us about the topology.
struct HelloInfo {
    pub ok: bool,            // the reply actually came back from a server (false = seed unreachable)
    pub isPrimary: bool,     // isWritablePrimary
    pub setName: string,     // replica-set name ("" for a standalone)
    pub primary: string,     // host:port of the current primary as this node sees it ("" if unknown)
    pub hosts: List<string>, // all advertised members (host:port)
    init() { self.ok = false; self.isPrimary = false; self.setName = ""; self.primary = ""; self.hosts = List<string>(); }
}

fn parseHello(reply: bson.BsonDocument): HelloInfo {
    let hi = HelloInfo();
    // A live server always echoes maxWireVersion (and ok); its absence means the seed was unreachable
    // (readFrame returned "" on the dead socket and decodeOpMsg produced an empty document).
    if (bson.docFind(reply, "maxWireVersion") < 0 && bson.docFind(reply, "ok") < 0) { return hi; }
    hi.ok = true;
    let pIdx = bson.docFind(reply, "isWritablePrimary");
    if (pIdx >= 0) { hi.isPrimary = bson.docGetBool(reply, pIdx) != 0; }
    let sIdx = bson.docFind(reply, "setName");
    if (sIdx >= 0) { hi.setName = bson.docGetString(reply, sIdx); }
    let prIdx = bson.docFind(reply, "primary");
    if (prIdx >= 0) { hi.primary = bson.docGetString(reply, prIdx); }
    let hIdx = bson.docFind(reply, "hosts");
    if (hIdx >= 0) {
        let arr = bson.deserialize(bson.docGetArray(reply, hIdx) as ptr);
        let i = 0;
        while (i < arr.entries.size()) {
            if (bson.docGetType(arr, i) == 2) { hi.hosts.push(bson.docGetString(arr, i)); }
            i = i + 1;
        }
    }
    return hi;
}

// Open a raw async stream to host:port honouring the TLS options; widening to the AsyncIO seam.
// MongoDB uses IMPLICIT TLS (encryption from the first byte), so tlsConnect[Verify] (TLS 1.3, pure
// Nova) is the whole story; `tls=verify` enforces the certificate chain.
async fn openStream(host: string, port: int, useTls: bool, verify: bool, caPem: string): aio.AsyncIO {
    if (useTls) {
        if (verify) { return await asynctls.tlsConnectVerify(host, port, caPem); }
        return await asynctls.tlsConnect(host, port, false);
    }
    return await aio.asyncConnect(host, port);
}

// SCRAM-authenticate an already-connected + hello'd connection (nonce from the CSPRNG, never reused).
async fn finishAuth(conn: MongoConnection, user: string, pass: string): MongoConnection {
    if (user != "") {
        let ok = await conn.authenticate(user, pass, random.randomHex(18));
        if (!ok) { conn.markFailed("mongodb: authentication failed for user '" + user + "'"); }
    }
    return conn;
}

// Choose the member to talk to for a read preference. Secondaries are the members other than the
// primary. On a single-node set there are none, so secondary/nearest degrade to the primary (rather
// than failing the connect) -- the honest behaviour for a set that has no secondary to route to.
fn selectTarget(primary: string, hosts: List<string>, readPref: int): string {
    if (readPref == RP_PRIMARY || readPref == RP_PRIMARY_PREFERRED) { return primary; }
    let i = 0;
    while (i < hosts.size()) {
        let h = hosts.get(i) ?? "";
        if (h != "" && !string.eql(h, primary)) { return h; }
        i = i + 1;
    }
    return primary;
}

// A connection object over a dead (fd -1) stream, so a discovery failure still returns a Connection
// whose first query/exec surfaces the reason (never a null / crash).
fn deadConn(dbName: string, why: string): MongoConnection {
    let c = MongoConnection(aio.AsyncStream((0 - 1) as long), dbName);
    c.markFailed(why);
    return c;
}

// DSN forms:
//   mongodb://[user:pass@]host[:port][,host2[:port2]...][/db][?replicaSet=NAME&readPreference=..&tls=..]
//   mongodb+srv://...   -- DNS SRV/TXT expansion is a follow-on; this fails loudly (see below) rather
//                          than silently connecting to the wrong place.
// Given a seed list, the driver runs SDAM discovery: `hello` each seed until one answers, learns the
// replica-set name + members + current primary, then connects (and SCRAM-auths) to the read-preference
// target. Unreachable seeds are skipped, so a stale/dead seed in the list does not fail the connect.
async fn mongoConnectAsync(dsn: string): MongoConnection {
    let tlsOpt = dsnParam(dsn, "tls", "false");
    let useTls = string.eql(tlsOpt, "true") || string.eql(tlsOpt, "verify");
    let verify = string.eql(tlsOpt, "verify");
    let caFile = dsnParam(dsn, "tlsCAFile", "");
    let caPem = if (verify && caFile != "") File.readText(caFile) else "";
    let replicaSet = dsnParam(dsn, "replicaSet", "");
    let readPref = parseReadPref(dsnParam(dsn, "readPreference", "primary"));
    let retryWrites = !string.eql(dsnParam(dsn, "retryWrites", "true"), "false");
    let isSrv = string.indexOf(dsn, "mongodb+srv://") == 0;

    let base = dsn;
    let qq = string.indexOf(base, "?");
    if (qq != -1) { base = string.slice(base, 0, qq); }
    let sch = string.indexOf(base, "://");
    if (sch != -1) { base = string.slice(base, sch + 3, base.length); }

    // Credentials: [user[:pass]@]host...
    let user = "";
    let pass = "";
    let at = string.lastIndexOf(base, "@");
    if (at != -1) {
        let cred = string.slice(base, 0, at);
        base = string.slice(base, at + 1, base.length);
        let cc = string.indexOf(cred, ":");
        if (cc == -1) { user = cred; }
        else { user = string.slice(cred, 0, cc); pass = string.slice(cred, cc + 1, cred.length); }
    }

    // Split the host section (which may be a comma-separated seed list) from the database name.
    let slash = string.indexOf(base, "/");
    let hostSection = if (slash >= 0) string.slice(base, 0, slash) else base;
    let dbName0 = if (slash >= 0) string.slice(base, slash + 1, base.length) else "test";
    let dbName = if (dbName0 != "") dbName0 else "test";

    // Seeds come from the host section, EXCEPT for mongodb+srv:// where they are the SRV records of the
    // single host. srv:// also implies TLS (unless tls= is set) and may pull replicaSet from a TXT record.
    let seeds = string.split(hostSection, ",");
    if (isSrv) {
        let sr = srv.resolve(hostSection);
        if (!sr.ok) { return deadConn(dbName, "mongodb+srv:// resolution failed: " + sr.err); }
        seeds = sr.hosts;
        if (string.eql(dsnParam(dsn, "tls", ""), "")) { useTls = true; }   // srv:// defaults to TLS
        if (string.eql(replicaSet, "")) { replicaSet = txtOption(sr.options, "replicaSet"); }
    }

    let lastErr = "no seeds in DSN";
    let i = 0;
    while (i < seeds.size()) {
        let seed = string.trim(seeds.get(i) ?? "");
        i = i + 1;
        if (seed == "") { continue; }
        let hp = splitHostPort(seed);
        let probe = MongoConnection(await openStream(hp.host, hp.port, useTls, verify, caPem), dbName);
        let info = parseHello(await probe.runCommand(commands.helloCommand(dbName)));
        if (!info.ok) { lastErr = "seed " + seed + " unreachable"; continue; }
        if (replicaSet != "" && info.setName != "" && !string.eql(info.setName, replicaSet)) {
            lastErr = "seed " + seed + " is in replica set '" + info.setName + "', wanted '" + replicaSet + "'";
            continue;
        }
        // Where is the primary? A primary seed knows it is itself; a secondary reports it in `primary`.
        let primary = if (info.isPrimary) seed else info.primary;
        if (!info.isPrimary && primary == "") {
            lastErr = "seed " + seed + " reachable but reports no primary yet (election in progress?)";
            continue;
        }
        let target = selectTarget(primary, info.hosts, readPref);
        // If the reachable seed already IS the target node, reuse its connection instead of dialling again.
        if (info.ok && string.eql(target, seed) && info.isPrimary) {
            let c = await finishAuth(probe, user, pass);
            c.setTopology(info.setName, seed, info.hosts);
            c.retryWrites = retryWrites;
            c.dsn = dsn;
            c.serverType = if (info.setName != "") "RSPrimary" else "Standalone";
            c.wantsPrimary = readPref == RP_PRIMARY || readPref == RP_PRIMARY_PREFERRED;
            return c;
        }
        let thp = splitHostPort(target);
        let tconn = MongoConnection(await openStream(thp.host, thp.port, useTls, verify, caPem), dbName);
        let tinfo = parseHello(await tconn.runCommand(commands.helloCommand(dbName)));
        if (!tinfo.ok) { lastErr = "read-preference target " + target + " unreachable"; continue; }
        // Verify the target actually satisfies the read preference. A seed's `primary` field can be STALE
        // during a failover (it names the node that just stepped down), so a primary-seeking connect must
        // confirm the target is really primary -- otherwise we would pin to a stale primary. Rejecting it
        // lets the caller (discovery loop / reconnect retry) find the node that won the election.
        if ((readPref == RP_PRIMARY || readPref == RP_PRIMARY_PREFERRED) && !tinfo.isPrimary) {
            lastErr = "target " + target + " is not primary yet (election in progress?)";
            continue;
        }
        let c = await finishAuth(tconn, user, pass);
        c.setTopology(tinfo.setName, target, tinfo.hosts);
        c.retryWrites = retryWrites;
        c.dsn = dsn;
        c.serverType = if (tinfo.isPrimary) "RSPrimary" else if (tinfo.setName != "") "RSSecondary" else "Standalone";
        c.wantsPrimary = readPref == RP_PRIMARY || readPref == RP_PRIMARY_PREFERRED;
        return c;
    }
    return deadConn(dbName, "mongodb: could not reach a usable node (" + lastErr + ")");
}

pub struct MongoDriver impl Driver {
    /// `dsn` is a mongodb:// URI: single host, a comma-separated seed list, credentials, and the
    /// replicaSet / readPreference / tls query options. The connect runs SDAM discovery and returns a
    /// connection to the read-preference target. mongodb+srv:// is recognised but not yet resolved.
    pub async fn connect(self, dsn: string): Connection {
        return await mongoConnectAsync(dsn);   // sync trait method drives the async connect once
    }
}

// --- native document API: Database / Collection / Cursor (P2 read path) --------------------------

// One page of a cursor reply: the (possibly zero) server cursor id + the batch of documents.
struct CursorPage {
    pub cursorId: long,
    pub docs: List<document.Doc>,
    init() { self.cursorId = 0; self.docs = List<document.Doc>(); }
}
// Extract (cursor.id, <batchKey> array of Docs) from a find/getMore reply. batchKey = "firstBatch"
// (find) or "nextBatch" (getMore).
fn readCursorReply(reply: bson.BsonDocument, batchKey: string): CursorPage {
    let cp = CursorPage();
    let cursorIdx = bson.docFind(reply, "cursor");
    if (cursorIdx < 0) { return cp; }
    let cursorDoc = bson.deserialize(bson.docGetDoc(reply, cursorIdx) as ptr);
    let idIdx = bson.docFind(cursorDoc, "id");
    if (idIdx >= 0) { cp.cursorId = bson.docGetInt64(cursorDoc, idIdx); }
    let bIdx = bson.docFind(cursorDoc, batchKey);
    if (bIdx < 0) { return cp; }
    let arr = bson.deserialize(bson.docGetArray(cursorDoc, bIdx) as ptr);
    let i = 0;
    while (i < arr.entries.size()) {
        cp.docs.push(document.wrapDoc(bson.deserialize(bson.docGetDoc(arr, i) as ptr)));
        i = i + 1;
    }
    return cp;
}

// A lazy cursor over a query result. Yields the buffered batch, then getMore's the next one until the
// server cursor id is 0 (exhausted); killCursors on close() if it was not fully drained.
pub struct Cursor {
    pub conn: MongoConnection,
    pub dbName: string,
    pub coll: string,
    pub cursorId: long,
    pub batch: List<document.Doc>,
    pub pos: int,
    pub err: DbError,
    init(conn: MongoConnection, dbName: string, coll: string) {
        self.conn = conn; self.dbName = dbName; self.coll = coll;
        self.cursorId = 0; self.batch = List<document.Doc>(); self.pos = 0; self.err = db.noError();
    }
    pub fn ok(self: Cursor): bool { return self.err.isEmpty(); }

    // The next document, or undefined when the cursor is exhausted. Drives getMore transparently.
    pub async fn next(self: Cursor): document.Doc | undefined {
        if (self.pos < self.batch.size()) { let d = self.batch.get(self.pos) ?? document.doc(); self.pos = self.pos + 1; return d; }
        if (self.cursorId == 0) { return undefined; }
        let reply = await self.conn.runCommand(commands.getMoreCommand(self.dbName, self.coll, self.cursorId, 101));
        let e = commands.commandError(reply);
        if (!e.isEmpty()) { self.err = e; self.cursorId = 0; return undefined; }
        let page = readCursorReply(reply, "nextBatch");
        self.cursorId = page.cursorId;
        self.batch = page.docs;
        self.pos = 0;
        if (self.batch.size() == 0) { return undefined; }
        let d2 = self.batch.get(0) ?? document.doc();
        self.pos = 1;
        return d2;
    }
    // Eager drain of the whole result into a list (bounded by the result size).
    pub async fn toList(self: Cursor): List<document.Doc> {
        let out = List<document.Doc>();
        while (true) {
            let dn = await self.next();
            if (dn == undefined) { break; }
            out.push(dn);
        }
        return out;
    }
    // Release a not-yet-exhausted server cursor.
    pub async fn close(self: Cursor): void {
        if (self.cursorId != 0) {
            let _ = await self.conn.runCommand(commands.killCursorsCommand(self.dbName, self.coll, self.cursorId));
            self.cursorId = 0;
        }
    }
}

// Error codes that mark a write as safe to retry (the retryable-writes spec's retryable set): network /
// not-writable-primary / interrupted-at-shutdown / stepped-down and friends. NOT duplicate-key (11000)
// or validation (121) -- retrying those cannot help.
fn isRetryableCode(code: int): bool {
    return code == 6 || code == 7 || code == 89 || code == 91 || code == 189 || code == 262
        || code == 9001 || code == 10107 || code == 11600 || code == 11602 || code == 13435 || code == 13436;
}

// Should the reply to a write be retried? A dropped connection surfaces as an EMPTY reply (readFrame ""
// on the dead socket), which is retryable; otherwise the write's error code decides.
fn isRetryableReply(reply: bson.BsonDocument): bool {
    if (isEmptyReply(reply)) { return true; }
    let e = commands.writeError(reply);
    if (e.isEmpty()) { return false; }
    return isRetryableCode(e.number);
}

// An empty reply = the connection dropped (readFrame "" -> decodeOpMsg produced a doc with no fields).
fn isEmptyReply(reply: bson.BsonDocument): bool {
    return bson.docFind(reply, "ok") < 0 && bson.docFind(reply, "n") < 0
        && bson.docFind(reply, "errmsg") < 0 && bson.docFind(reply, "writeErrors") < 0;
}

// "Not primary" / stepped-down / shutdown codes: the current server can no longer serve a primary op, so
// the fix is to FIND THE NEW PRIMARY (reconnect), not to retry on the same socket.
fn isNotPrimaryCode(code: int): bool {
    return code == 10107 || code == 13435 || code == 13436 || code == 11602 || code == 189
        || code == 91 || code == 10058 || code == 11600;
}

// Does the reply say we have lost the primary (a not-primary error or a dropped connection)?
fn isNotPrimaryReply(reply: bson.BsonDocument): bool {
    if (isEmptyReply(reply)) { return true; }
    let e = commands.writeError(reply);
    if (e.isEmpty()) { return false; }
    return isNotPrimaryCode(e.number);
}

pub struct Collection {
    pub conn: MongoConnection,
    pub dbName: string,
    pub coll: string,
    pub sess: Session | undefined,   // when bound, in-transaction ops carry lsid/txnNumber/autocommit
    init(conn: MongoConnection, dbName: string, coll: string) { self.conn = conn; self.dbName = dbName; self.coll = coll; self.sess = undefined; }

    // Bind a session so this collection's operations join its transaction (returns self for chaining).
    pub fn withSession(self: Collection, s: Session): Collection { self.sess = s; return self; }
    // Run a command, attaching the transaction context (lsid / txnNumber / autocommit / startTransaction
    // on the first op) when this collection is bound to a session that is in a transaction.
    async fn run(self: Collection, cmd: bson.BsonDocument): bson.BsonDocument {
        let s = self.sess;
        if (s != undefined) {
            if (s.inTxn) {
                cmd.entries.push(lsidEntry(s.lsid));
                cmd.entries.push(bson.entryInt64Val("txnNumber", s.txnNumber));
                cmd.entries.push(bson.entryBool("autocommit", 0));
                if (s.firstOp) { cmd.entries.push(bson.entryBool("startTransaction", 1)); s.firstOp = false; }
                return await self.conn.runCommand(cmd);   // inside a transaction: no auto-failover
            }
        }
        // Reads + non-transactional commands auto-fail-over on a lost primary (reconnect + retry once).
        return await self.conn.runCommandFailover(cmd);
    }

    // Run a write, applying retryable-writes semantics. Inside an explicit transaction the write joins
    // the transaction (via run, no retry layer). Otherwise, when eligible (retryable single-doc write,
    // retryWrites on, and the server supports sessions -- i.e. a replica set / mongos, setName != ""),
    // an implicit-session lsid + a fresh txnNumber are attached and the write is retried ONCE on a
    // retryable error; the same txnNumber makes the retry idempotent (the server dedups). A standalone
    // (setName == "") or a disabled/ineligible write falls back to a plain, un-tagged send.
    pub async fn runWrite(self: Collection, cmd: bson.BsonDocument, retryable: bool): bson.BsonDocument {
        let s = self.sess;
        if (s != undefined) {
            if (s.inTxn) { return await self.run(cmd); }
        }
        if (retryable && self.conn.retryWrites && self.conn.setName != "") {
            await self.conn.ensureImplicitSession();
            if (self.conn.implicitLsid != "") {
                cmd.entries.push(lsidEntry(self.conn.implicitLsid));
                cmd.entries.push(bson.entryInt64Val("txnNumber", self.conn.nextImplicitTxn()));
                let reply = await self.conn.runCommand(cmd);
                if (isRetryableReply(reply)) {
                    // A lost primary needs the NEW primary (reconnect); a plain transient retries in place.
                    if (isNotPrimaryReply(reply) && self.conn.wantsPrimary) {
                        if (await self.conn.reconnect()) { return await self.conn.runCommand(cmd); }
                    }
                    return await self.conn.runCommand(cmd);   // retry once (same txnNumber; server dedups)
                }
                return reply;
            }
        }
        return await self.run(cmd);
    }

    // find with server-side filter/projection/sort/skip/limit; returns a lazy Cursor.
    pub async fn find(self: Collection, f: document.Filter, opts: document.FindOptions): Cursor {
        let cmd = commands.findCommandFull(self.dbName, self.coll, f.toBson(), opts.projection, opts.sort, opts.skip, opts.limit, opts.batchSize);
        let reply = await self.run(cmd);
        let cur = Cursor(self.conn, self.dbName, self.coll);
        let e = commands.commandError(reply);
        if (!e.isEmpty()) { cur.err = e; return cur; }
        let page = readCursorReply(reply, "firstBatch");
        cur.cursorId = page.cursorId;
        cur.batch = page.docs;
        return cur;
    }
    // The first matching document (limit 1), or undefined.
    pub async fn findOne(self: Collection, f: document.Filter): document.Doc | undefined {
        let cur = await self.find(f, document.findOptions().withLimit(1));
        let d = await cur.next();
        let _ = await cur.close();
        return d;
    }
    // Whole-collection convenience: find(all()).
    pub async fn findAll(self: Collection): Cursor { return await self.find(document.all(), document.findOptions()); }

    // -- writes (P3) --

    // Insert one document. Pass a @serializable struct DTO wrapped in `docOf(...)` -- it is serialized to
    // BSON for you -- or a hand-built document.Doc. (serde.dump<T> resolves the concrete type only in a
    // SYNC context, so the DTO -> Doc conversion is the free function `docOf<T>`, not this async method.)
    pub async fn insertOne(self: Collection, d: document.Doc): InsertResult {
        let docs = List<document.Doc>();
        docs.push(d);
        return await self.insertMany(docs);
    }
    // Insert one or more documents. Any document without an `_id` gets a client-generated ObjectId
    // (returned in insertedIds), matching official-driver behaviour so you can read/query it back.
    pub async fn insertMany(self: Collection, docs: List<document.Doc>): InsertResult {
        let res = InsertResult();
        let bdocs = List<bson.BsonDocument>();
        let i = 0;
        while (i < docs.size()) {
            let d = docs.get(i) ?? document.doc();
            if (!d.has("_id")) {
                let oid = newObjectId();
                let _ = d.setObjectId("_id", oid);
                res.insertedIds.push(oid);
            } else {
                let x = d.getObjectId("_id");
                if (x != undefined) { res.insertedIds.push(x); }
            }
            bdocs.push(d.bson);
            i = i + 1;
        }
        // Inserts are retryable writes (a single batch is idempotent under the same txnNumber).
        let reply = await self.runWrite(commands.insertManyCommand(self.dbName, self.coll, bdocs), true);
        let e = commands.writeError(reply);
        if (!e.isEmpty()) { res.err = e; return res; }
        res.insertedCount = numAt(reply, "n");
        return res;
    }

    pub async fn updateOne(self: Collection, f: document.Filter, u: document.Update, upsert: bool): UpdateResult {
        return await self.doUpdate(f, u.toBson(), upsert, false);
    }
    pub async fn updateMany(self: Collection, f: document.Filter, u: document.Update): UpdateResult {
        return await self.doUpdate(f, u.toBson(), false, true);
    }
    // Replace the whole matched document (the replacement is a plain doc, no update operators).
    pub async fn replaceOne(self: Collection, f: document.Filter, replacement: document.Doc, upsert: bool): UpdateResult {
        return await self.doUpdate(f, replacement.bson, upsert, false);
    }
    async fn doUpdate(self: Collection, f: document.Filter, updateBson: bson.BsonDocument, upsert: bool, multi: bool): UpdateResult {
        let res = UpdateResult();
        // A single-document update (multi == false) is retryable; a multi update is not.
        let reply = await self.runWrite(commands.updateCommand(self.dbName, self.coll, f.toBson(), updateBson, upsert, multi), !multi);
        let e = commands.writeError(reply);
        if (!e.isEmpty()) { res.err = e; return res; }
        res.matched = numAt(reply, "n");
        res.modified = numAt(reply, "nModified");
        let uIdx = bson.docFind(reply, "upserted");
        if (uIdx >= 0) {
            let arr = bson.deserialize(bson.docGetArray(reply, uIdx) as ptr);
            if (arr.entries.size() > 0) {
                let e0 = bson.deserialize(bson.docGetDoc(arr, 0) as ptr);
                let idIdx = bson.docFind(e0, "_id");
                if (idIdx >= 0 && bson.docGetType(e0, idIdx) == 7) { res.upsertedId = bson.docGetObjectId(e0, idIdx); }
            }
        }
        return res;
    }

    pub async fn deleteOne(self: Collection, f: document.Filter): DeleteResult { return await self.doDelete(f, 1); }
    pub async fn deleteMany(self: Collection, f: document.Filter): DeleteResult { return await self.doDelete(f, 0); }
    async fn doDelete(self: Collection, f: document.Filter, limit: int): DeleteResult {
        let res = DeleteResult();
        // A single-document delete (limit == 1) is retryable; an unlimited delete is not.
        let reply = await self.runWrite(commands.deleteCommand(self.dbName, self.coll, f.toBson(), limit), limit == 1);
        let e = commands.writeError(reply);
        if (!e.isEmpty()) { res.err = e; return res; }
        res.deletedCount = numAt(reply, "n");
        return res;
    }

    // Atomically update the first match and return the pre- or post-image (returnNew), or undefined
    // if nothing matched (and no upsert).
    pub async fn findOneAndUpdate(self: Collection, f: document.Filter, u: document.Update, returnNew: bool, upsert: bool): document.Doc | undefined {
        // findAndModify targets a single document, so it is retryable.
        let reply = await self.runWrite(commands.findAndModifyCommand(self.dbName, self.coll, f.toBson(), u.toBson(), returnNew, upsert), true);
        let vIdx = bson.docFind(reply, "value");
        if (vIdx < 0 || bson.docGetType(reply, vIdx) != 3) { return undefined; }   // absent / null (type 10)
        return document.wrapDoc(bson.deserialize(bson.docGetDoc(reply, vIdx) as ptr));
    }

    // Start a bulk write: a mix of insert/update/delete queued on a builder and sent in grouped batches.
    pub fn bulk(self: Collection): BulkWrite { return BulkWrite(self); }

    // -- aggregation / count / distinct / indexes (P4) --

    // Run an aggregation pipeline (a list of stage documents) and return a lazy Cursor over the result.
    pub async fn aggregate(self: Collection, pipeline: List<document.Doc>): Cursor {
        let bp = List<bson.BsonDocument>();
        let i = 0;
        while (i < pipeline.size()) { bp.push((pipeline.get(i) ?? document.doc()).bson); i = i + 1; }
        let reply = await self.run(commands.aggregateCommand(self.dbName, self.coll, bp, 101));
        let cur = Cursor(self.conn, self.dbName, self.coll);
        let e = commands.commandError(reply);
        if (!e.isEmpty()) { cur.err = e; return cur; }
        let page = readCursorReply(reply, "firstBatch");
        cur.cursorId = page.cursorId;
        cur.batch = page.docs;
        return cur;
    }
    // Exact count of documents matching `f`, via aggregate [{$match}, {$count}].
    pub async fn countDocuments(self: Collection, f: document.Filter): long {
        let pipe = List<document.Doc>();
        let _ = pipe.push(document.doc().setDoc("$match", document.wrapDoc(f.toBson())));
        let _2 = pipe.push(document.doc().setStr("$count", "n"));
        let cur = await self.aggregate(pipe);
        let d = await cur.next();
        let _3 = await cur.close();
        if (d == undefined) { return 0; }
        return d.getInt("n") ?? (0 as long);
    }
    // Fast metadata estimate of the whole-collection count (no filter).
    pub async fn estimatedDocumentCount(self: Collection): long {
        let reply = await self.run(commands.countCommand(self.dbName, self.coll, commands.newDoc()));
        return numAt(reply, "n");
    }
    // Distinct scalar values of `field` among documents matching `f`, each rendered to its string form
    // (full typed Value results are a follow-on).
    pub async fn distinct(self: Collection, field: string, f: document.Filter): List<string> {
        let out = List<string>();
        let vs = await self.distinctValues(field, f);
        let i = 0;
        while (i < vs.size()) { out.push((vs.get(i) ?? document.nullValue()).toStr()); i = i + 1; }
        return out;
    }
    // distinct as TYPED values -- each element keeps its real BSON type (string/int/double/bool/objectId/
    // date/doc/array), so callers use v.asInt()/asStr()/... instead of parsing a stringified result.
    pub async fn distinctValues(self: Collection, field: string, f: document.Filter): List<document.Value> {
        let reply = await self.run(commands.distinctCommand(self.dbName, self.coll, field, f.toBson()));
        let vIdx = bson.docFind(reply, "values");
        if (vIdx < 0) { return List<document.Value>(); }
        return document.readValues(bson.deserialize(bson.docGetArray(reply, vIdx) as ptr));
    }
    // Create an index over `keys` (e.g. doc().setInt("age", 1)); returns the (classified) DbError, empty on success.
    pub async fn createIndex(self: Collection, keys: document.Doc, name: string, unique: bool): DbError {
        let reply = await self.conn.runCommand(commands.createIndexCommand(self.dbName, self.coll, keys.bson, name, unique));
        return commands.commandError(reply);
    }
    pub async fn dropIndex(self: Collection, name: string): DbError {
        let reply = await self.conn.runCommand(commands.dropIndexCommand(self.dbName, self.coll, name));
        return commands.commandError(reply);
    }
}

pub struct Database {
    pub conn: MongoConnection,
    pub name: string,
    init(conn: MongoConnection, name: string) { self.conn = conn; self.name = name; }
    pub fn collection(self: Database, coll: string): Collection { return Collection(self.conn, self.name, coll); }
}

// --- native document API entry points (re-exported so consumers only `import mongodb`) -----------

// Connect and return the CONCRETE MongoConnection (the document API hangs off it). The seam's
// Driver.connect returns the Connection trait, which cannot reach database()/collection().
pub async fn open(dsn: string): MongoConnection { return await mongoConnectAsync(dsn); }

// Builder re-exports: `mongodb.filter().eqInt(...)`, `mongodb.findOptions().sortAsc(...)`, `mongodb.doc()`.
pub fn filter(): document.Filter { return document.filter(); }
pub fn all(): document.Filter { return document.all(); }
pub fn doc(): document.Doc { return document.doc(); }
pub fn nullValue(): document.Value { return document.nullValue(); }

// Serialize a @serializable struct DTO into a Doc, so you can write `coll.insertOne(docOf(myDto))`
// instead of hand-building the document. SYNC on purpose: serde.dump<T> resolves the concrete type
// only outside an async frame, so keep the conversion here and the insert async.
pub fn docOf<T>(dto: T): document.Doc {
    let sink = document.newMongoSink();
    serde.dump<T>(dto, sink);
    return document.wrapDoc(sink.d);
}

// Deserialize a fetched Doc into a @serializable struct DTO (the read complement of docOf). Also SYNC:
// serde.bind<T> resolves the concrete type only outside an async frame, so fetch first (await), then bind:
//   let items = mongodb.bindAll<Item>(await coll.find(f, opts).toList());
//   let one   = mongodb.bindOne<Item>(await coll.findOne(f));   // findOne -> Doc | undefined
pub fn bindOne<T>(d: document.Doc): T {
    return serde.bind<T>(document.docSource(d));
}
pub fn bindAll<T>(docs: List<document.Doc>): List<T> {
    let out = List<T>();
    let i = 0;
    while (i < docs.size()) {
        let d = docs.get(i);
        if (d != undefined) { out.push(serde.bind<T>(document.docSource(d))); }
        i = i + 1;
    }
    return out;
}
pub fn findOptions(): document.FindOptions { return document.findOptions(); }
pub fn update(): document.Update { return document.update(); }

// --- write results + helpers (P3) ---------------------------------------------------------------

pub struct InsertResult {
    pub insertedCount: long,
    pub insertedIds: List<string>,   // hex ObjectIds (client-generated when the doc had no _id)
    pub err: DbError,
    init() { self.insertedCount = 0; self.insertedIds = List<string>(); self.err = db.noError(); }
    pub fn ok(self: InsertResult): bool { return self.err.isEmpty(); }
}
pub struct UpdateResult {
    pub matched: long,
    pub modified: long,
    pub upsertedId: string,          // hex ObjectId of an upsert, or "" if none
    pub err: DbError,
    init() { self.matched = 0; self.modified = 0; self.upsertedId = ""; self.err = db.noError(); }
    pub fn ok(self: UpdateResult): bool { return self.err.isEmpty(); }
}
pub struct DeleteResult {
    pub deletedCount: long,
    pub err: DbError,
    init() { self.deletedCount = 0; self.err = db.noError(); }
    pub fn ok(self: DeleteResult): bool { return self.err.isEmpty(); }
}

// Generate a fresh 24-hex ObjectId (12 CSPRNG bytes -- valid + unique; the spec's time+counter layout
// is not required for uniqueness).
pub fn newObjectId(): string { return random.randomHex(12); }

// --- bulk write: a typed WriteOp queue executed in grouped batches -------------------------------

pub const BULK_INSERT: int = 0;
pub const BULK_UPDATE: int = 1;   // updateOne / updateMany / replaceOne all lower to an update spec
pub const BULK_DELETE: int = 2;

// One queued operation. `spec` is the insert document (BULK_INSERT) or the pre-built update/delete spec
// ({ q, u, upsert, multi } / { q, limit }).
pub struct WriteOp {
    pub kind: int,
    pub spec: bson.BsonDocument,
    init(kind: int, spec: bson.BsonDocument) { self.kind = kind; self.spec = spec; }
}

pub struct BulkResult {
    pub insertedCount: long,
    pub matchedCount: long,
    pub modifiedCount: long,
    pub deletedCount: long,
    pub upsertedCount: long,
    pub err: DbError,
    init() {
        self.insertedCount = 0; self.matchedCount = 0; self.modifiedCount = 0;
        self.deletedCount = 0; self.upsertedCount = 0; self.err = db.noError();
    }
    pub fn ok(self: BulkResult): bool { return self.err.isEmpty(); }
}

// An update spec { q, u, upsert, multi } for the bulk update command.
fn updateSpec(filter: bson.BsonDocument, updateDoc: bson.BsonDocument, upsert: bool, multi: bool): bson.BsonDocument {
    let u = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
    u.entries.push(bson.entryDoc("q", bson.serialize(filter)));
    u.entries.push(bson.entryDoc("u", bson.serialize(updateDoc)));
    u.entries.push(bson.entryBool("upsert", if (upsert) 1 else 0));
    u.entries.push(bson.entryBool("multi", if (multi) 1 else 0));
    return u;
}
// A delete spec { q, limit } for the bulk delete command.
fn deleteSpec(filter: bson.BsonDocument, limit: int): bson.BsonDocument {
    let del = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
    del.entries.push(bson.entryDoc("q", bson.serialize(filter)));
    del.entries.push(bson.entryInt("limit", limit));
    return del;
}
// Number of elements in a reply's array field (0 if absent) -- used to count upserts.
fn arraySize(reply: bson.BsonDocument, key: string): long {
    let i = bson.docFind(reply, key);
    if (i < 0 || bson.docGetType(reply, i) != 4) { return 0; }
    return bson.deserialize(bson.docGetArray(reply, i) as ptr).entries.size() as long;
}

// A fluent bulk-write builder. Queue insert/update/delete ops, then execute(ordered). Consecutive ops of
// the same kind are grouped into one insert/update/delete command (fewer round trips). For ordered the
// first failing batch stops the run; for unordered every batch is attempted. Not atomic (bulkWrite never
// is) -- wrap it in a session transaction for atomicity.
pub struct BulkWrite {
    pub coll: Collection,
    pub ops: List<WriteOp>,
    init(coll: Collection) { self.coll = coll; self.ops = List<WriteOp>(); }

    pub fn insertOne(self: BulkWrite, d: document.Doc): BulkWrite {
        if (!d.has("_id")) { let _ = d.setObjectId("_id", newObjectId()); }
        self.ops.push(WriteOp(BULK_INSERT, d.bson));
        return self;
    }
    pub fn updateOne(self: BulkWrite, f: document.Filter, u: document.Update, upsert: bool): BulkWrite {
        self.ops.push(WriteOp(BULK_UPDATE, updateSpec(f.toBson(), u.toBson(), upsert, false))); return self;
    }
    pub fn updateMany(self: BulkWrite, f: document.Filter, u: document.Update): BulkWrite {
        self.ops.push(WriteOp(BULK_UPDATE, updateSpec(f.toBson(), u.toBson(), false, true))); return self;
    }
    pub fn replaceOne(self: BulkWrite, f: document.Filter, replacement: document.Doc, upsert: bool): BulkWrite {
        self.ops.push(WriteOp(BULK_UPDATE, updateSpec(f.toBson(), replacement.bson, upsert, false))); return self;
    }
    pub fn deleteOne(self: BulkWrite, f: document.Filter): BulkWrite {
        self.ops.push(WriteOp(BULK_DELETE, deleteSpec(f.toBson(), 1))); return self;
    }
    pub fn deleteMany(self: BulkWrite, f: document.Filter): BulkWrite {
        self.ops.push(WriteOp(BULK_DELETE, deleteSpec(f.toBson(), 0))); return self;
    }

    pub async fn execute(self: BulkWrite, ordered: bool): BulkResult {
        let res = BulkResult();
        let i = 0;
        while (i < self.ops.size()) {
            let kind = (self.ops.get(i) ?? WriteOp(BULK_INSERT, commands.newDoc())).kind;
            let batch = List<bson.BsonDocument>();
            while (i < self.ops.size()) {
                let op = self.ops.get(i) ?? WriteOp(BULK_INSERT, commands.newDoc());
                if (op.kind != kind) { break; }
                batch.push(op.spec);
                i = i + 1;
            }
            let reply = commands.newDoc();
            if (kind == BULK_INSERT) {
                reply = await self.coll.runWrite(commands.insertManyCommandOrdered(self.coll.dbName, self.coll.coll, batch, ordered), false);
                res.insertedCount = res.insertedCount + numAt(reply, "n");
            } else {
                if (kind == BULK_UPDATE) {
                    reply = await self.coll.runWrite(commands.bulkUpdateCommand(self.coll.dbName, self.coll.coll, batch, ordered), false);
                    res.matchedCount = res.matchedCount + numAt(reply, "n");
                    res.modifiedCount = res.modifiedCount + numAt(reply, "nModified");
                    res.upsertedCount = res.upsertedCount + arraySize(reply, "upserted");
                } else {
                    reply = await self.coll.runWrite(commands.bulkDeleteCommand(self.coll.dbName, self.coll.coll, batch, ordered), false);
                    res.deletedCount = res.deletedCount + numAt(reply, "n");
                }
            }
            let e = commands.writeError(reply);
            if (!e.isEmpty()) {
                res.err = e;
                if (ordered) { return res; }
            }
        }
        return res;
    }
}

// Read a numeric reply field (n / nModified) whether the server encoded it as int32, int64 or double.
fn numAt(reply: bson.BsonDocument, key: string): long {
    let i = bson.docFind(reply, key);
    if (i < 0) { return 0; }
    let t = bson.docGetType(reply, i);
    if (t == 16 || t == 18) { return bson.docGetInt64(reply, i); }
    if (t == 1) { return bson.docGetDouble(reply, i) as long; }
    return 0;
}


// --- Session + multi-document transactions (P5) --------------------------------------------------

// A client session. Its server-assigned lsid rides on every command in a transaction; txnNumber
// identifies the transaction. Transactions require a replica set / mongos.
pub struct Session {
    pub conn: MongoConnection,
    pub lsid: string,        // raw serialized { id: <uuid binary> } sub-document bytes (from startSession)
    pub txnNumber: long,
    pub inTxn: bool,
    pub firstOp: bool,       // the first op of a transaction carries startTransaction: true
    init(conn: MongoConnection, lsid: string) {
        self.conn = conn; self.lsid = lsid; self.txnNumber = 0; self.inTxn = false; self.firstOp = false;
    }
    // Begin a transaction: bump the txnNumber and arm the startTransaction flag for the next op.
    pub fn startTransaction(self: Session): void {
        self.txnNumber = self.txnNumber + 1;
        self.inTxn = true;
        self.firstOp = true;
    }
    // A collection whose operations join this session's transaction.
    pub fn collection(self: Session, dbName: string, coll: string): Collection {
        return Collection(self.conn, dbName, coll).withSession(self);
    }
    // NOTE: the lsid document is built INLINE here (not via commands.commitTxnCommand) on purpose. Passing
    // the raw lsid bytes through a `lsid: string` parameter and then `bson.entryDoc(_, ptr)` launders away
    // ARC ownership of the buffer (entryDoc stores `ptr as string`, an alias), so the aliased bytes can be
    // reused before the command is serialised -> the server sees a corrupt lsid. Referencing `self.lsid`
    // inline keeps the buffer owned by the live Session across runCommand, exactly like Collection.run does.
    pub async fn commitTransaction(self: Session): DbError {
        if (!self.inTxn) { return db.noError(); }
        let cmd = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
        cmd.entries.push(bson.entryInt("commitTransaction", 1));
        cmd.entries.push(lsidEntry(self.lsid));
        cmd.entries.push(bson.entryInt64Val("txnNumber", self.txnNumber));
        cmd.entries.push(bson.entryBool("autocommit", 0));
        cmd.entries.push(bson.entryString("$db", "admin"));
        let reply = await self.conn.runCommand(cmd);
        self.inTxn = false;
        return commands.commandError(reply);
    }
    pub async fn abortTransaction(self: Session): DbError {
        if (!self.inTxn) { return db.noError(); }
        let cmd = bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
        cmd.entries.push(bson.entryInt("abortTransaction", 1));
        cmd.entries.push(lsidEntry(self.lsid));
        cmd.entries.push(bson.entryInt64Val("txnNumber", self.txnNumber));
        cmd.entries.push(bson.entryBool("autocommit", 0));
        cmd.entries.push(bson.entryString("$db", "admin"));
        let reply = await self.conn.runCommand(cmd);
        self.inTxn = false;
        return commands.commandError(reply);
    }
}
