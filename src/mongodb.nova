// nova-mongodb — a MongoDB driver for Nova, distributed as a PACKAGE.
//
// It depends only on the Nova standard library (the DB seam + BSON + the SCRAM
// crypto from crypto/scram), and is consumed via `nova get`. It speaks the
// MongoDB wire protocol directly:
//
//   OP_MSG (opcode 2013): [ 16-byte MsgHeader | uint32 flagBits | section... ]
//   section kind 0x00: a single BSON document (the command / the reply).
//
// A "command" is just a BSON document, e.g. { find: "users", $db: "test" }.
// Auth is SCRAM-SHA-256 (RFC 5802/7677) via crypto.scram — the payloads ride in
// BSON binary fields.

import bytes;
import string;
import list;
import serde.bson;
import crypto.scram;
import crypto.base64;
import net.asyncio;
import db;

const OP_MSG: int = 2013;
const HEADER_LEN: int = 16;
// header(16) + flagBits(4) + section-kind(1) = 21 bytes before the BSON body.
const BODY_OFFSET: int = 21;

// ---------------------------------------------------------------------------
// OP_MSG wire codec
// ---------------------------------------------------------------------------

/// Wrap a command document in an OP_MSG frame. Returns the raw frame bytes.
pub fn encodeOpMsg(requestId: int, command: bson.BsonDocument): string {
    // `bson.serialize` returns a fresh rc=1 buffer; adopt it as a string so ARC
    // frees it at scope end (a bare `ptr` is a value type and would leak).
    let body: string = bson.serialize(command) as string;
    let bsonLen = bytes.read_i32(body as ptr, 0);
    let total = BODY_OFFSET + bsonLen;

    let frame = bytes.alloc(total);
    bytes.write_i32(frame, 0, total);       // messageLength
    bytes.write_i32(frame, 4, requestId);   // requestID
    bytes.write_i32(frame, 8, 0);           // responseTo
    bytes.write_i32(frame, 12, OP_MSG);     // opCode
    bytes.write_i32(frame, 16, 0);          // flagBits
    bytes.write_byte(frame, 20, 0);         // section kind 0 (body)
    let i = 0;
    while (i < bsonLen) {
        bytes.write_byte(frame, BODY_OFFSET + i, bytes.read_byte(body, i));
        i = i + 1;
    }
    return frame as string;
}

/// Parse the command document out of an OP_MSG reply frame.
pub fn decodeOpMsg(frame: string): bson.BsonDocument {
    let bsonLen = bytes.read_i32(frame as ptr, BODY_OFFSET);
    let buf = bytes.alloc(bsonLen);
    let i = 0;
    while (i < bsonLen) {
        bytes.write_byte(buf, i, bytes.read_byte(frame, BODY_OFFSET + i));
        i = i + 1;
    }
    // Adopt the decode buffer as a string so ARC frees it; `deserialize` copies
    // everything out, so releasing it after is safe.
    let bufStr: string = buf as string;
    return bson.deserialize(bufStr as ptr);
}

/// The total length declared in an OP_MSG frame header (its first int32).
pub fn frameLength(frame: string): int {
    return bytes.read_i32(frame as ptr, 0);
}

// ---------------------------------------------------------------------------
// Command builders (each returns a BSON document ready for encodeOpMsg)
// ---------------------------------------------------------------------------

fn newDoc(): bson.BsonDocument {
    return bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
}

/// { hello: 1, $db: <db> } — the connection handshake command.
pub fn helloCommand(dbName: string): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryInt("hello", 1));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

// Wrap one document as the single-element array { "0": <doc> } (BSON arrays are
// documents whose keys are the decimal indices).
fn singletonArray(doc: bson.BsonDocument): ptr {
    let arr = newDoc();
    arr.entries.push(bson.entryDoc("0", bson.serialize(doc)));
    return bson.serialize(arr);
}

/// { insert: <coll>, documents: [<doc>], $db: <db> }.
pub fn insertCommand(dbName: string, coll: string, doc: bson.BsonDocument): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("insert", coll));
    d.entries.push(bson.entryArray("documents", singletonArray(doc)));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { find: <coll>, filter: <filter>, $db: <db> }.
pub fn findCommand(dbName: string, coll: string, filter: bson.BsonDocument): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("find", coll));
    d.entries.push(bson.entryDoc("filter", bson.serialize(filter)));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { saslStart: 1, mechanism: "SCRAM-SHA-256", payload: <bin>, $db: <db> }.
pub fn saslStartCommand(dbName: string, clientFirst: string): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryInt("saslStart", 1));
    d.entries.push(bson.entryString("mechanism", "SCRAM-SHA-256"));
    d.entries.push(bson.entryBinary("payload", clientFirst));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { saslContinue: 1, conversationId: <id>, payload: <bin>, $db: <db> }.
pub fn saslContinueCommand(dbName: string, conversationId: int, clientFinal: string): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryInt("saslContinue", 1));
    d.entries.push(bson.entryInt("conversationId", conversationId));
    d.entries.push(bson.entryBinary("payload", clientFinal));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Connection (live socket)
// ---------------------------------------------------------------------------

// A1 async-first seam: read exactly `n` bytes into a fresh string, parking on each recv.
async fn readExact(io: asyncio.AsyncStream, n: int): string {
    let buf = bytes.alloc(n);
    let got = 0;
    while (got < n) {
        let r = await io.recvInto((buf + got) as int, n - got);
        if (r <= 0) { break; }
        got = got + r;
    }
    return buf as string;
}
// Read a full OP_MSG frame (16-byte header carries messageLength, then the rest). Parks.
async fn readFrame(io: asyncio.AsyncStream): string {
    let head = await readExact(io, HEADER_LEN);
    let total = bytes.read_i32(head as ptr, 0);
    let rest = await readExact(io, total - HEADER_LEN);
    let full = bytes.alloc(total);
    let i = 0;
    while (i < HEADER_LEN) { bytes.write_byte(full, i, bytes.read_byte(head, i)); i = i + 1; }
    let j = 0;
    while (j < total - HEADER_LEN) { bytes.write_byte(full, HEADER_LEN + j, bytes.read_byte(rest, j)); j = j + 1; }
    return full as string;
}

pub struct MongoConnection impl Connection {
    pub io: asyncio.AsyncStream,
    pub dbName: string,
    pub nextId: int,

    init(io: asyncio.AsyncStream, dbName: string) {
        self.io = io;
        self.dbName = dbName;
        self.nextId = 1;
    }

    // Send one OP_MSG command and await the reply (the recv parks the coroutine).
    pub async fn runCommand(self: MongoConnection, command: bson.BsonDocument): bson.BsonDocument {
        let id = self.nextId;
        self.nextId = id + 1;
        let frame = encodeOpMsg(id, command);
        let dummy = await self.io.sendStr(frame);
        return decodeOpMsg(await readFrame(self.io));
    }

    pub async fn authenticate(self: MongoConnection, username: string, password: string, clientNonce: string): bool {
        let c = scram.ScramClient{ username: username, password: password, clientNonce: clientNonce };
        let start = await self.runCommand(saslStartCommand(self.dbName, c.clientFirstMessage()));
        let convIdx = bson.docFind(start, "conversationId");
        let payloadIdx = bson.docFind(start, "payload");
        if (convIdx < 0 || payloadIdx < 0) { return false; }
        let conversationId = bson.docGetInt(start, convIdx);
        let serverFirst = bson.docGetBinary(start, payloadIdx);
        let clientFinal = c.clientFinalMessage(serverFirst);
        let cont = await self.runCommand(saslContinueCommand(self.dbName, conversationId, clientFinal));
        let doneIdx = bson.docFind(cont, "done");
        return doneIdx >= 0 && bson.docGetBool(cont, doneIdx) != 0;
    }

    pub async fn query(self: MongoConnection, sql: string, params: List<DbValue>): ResultSet {
        let reply = await self.runCommand(findCommand(self.dbName, sql, newDoc()));
        let rs = ResultSet();
        let okIdx = bson.docFind(reply, "ok");
        let row = Row();
        row.cells.push(db.dbInt(if (okIdx >= 0) 1 else 0));
        rs.rows.push(row);
        return rs;
    }

    pub async fn exec(self: MongoConnection, sql: string, params: List<DbValue>): ExecResult {
        let reply = await self.runCommand(findCommand(self.dbName, sql, newDoc()));
        let okIdx = bson.docFind(reply, "ok");
        return ExecResult((if (okIdx >= 0) 1 else 0) as long, "");
    }

    pub fn close(self: MongoConnection): void {
        self.io.close();
    }

    pub fn setTimeout(self, ms: int): int {   // D6 — async per-recv awaited deadline
        return self.io.setTimeout(ms);
    }

    // MongoDB has no SQL prepared statements; the seam's prepare/queryPrepared/execPrepared are
    // emulated by re-running the command (kept for trait conformance — the mongo-native API is
    // runCommand + the find/insert helpers).
    pub async fn prepare(self: MongoConnection, sql: string): int { return 0; }
    pub async fn queryPrepared(self: MongoConnection, stmt: int, params: List<DbValue>): ResultSet {
        return await self.query("", params);
    }
    pub async fn execPrepared(self: MongoConnection, stmt: int, params: List<DbValue>): ExecResult {
        return await self.exec("", params);
    }
}

// Whole connect (+ optional SCRAM auth) as ONE async fn, driven once by the sync Driver.connect.
async fn mongoConnectAsync(dsn: string): MongoConnection {
    let hostEnd = string.indexOf(dsn, ":");
    let host = if (hostEnd >= 0) string.slice(dsn, 0, hostEnd) else "127.0.0.1";
    let rest = if (hostEnd >= 0) string.slice(dsn, hostEnd + 1, dsn.length) else dsn;
    let portEnd = string.indexOf(rest, "/");
    let portStr = if (portEnd >= 0) string.slice(rest, 0, portEnd) else rest;
    let dbName = if (portEnd >= 0) string.slice(rest, portEnd + 1, rest.length) else "test";
    let port = string.parseI64(portStr);
    let stream = await asyncio.asyncConnect(host, if (port > 0) port else 27017);
    return MongoConnection(stream, dbName);
}

pub struct MongoDriver impl Driver {
    /// `dsn` is "host:port/db" (a minimal form; full mongodb:// URIs are a follow-up).
    pub async fn connect(self, dsn: string): Connection {
        return await mongoConnectAsync(dsn);   // sync trait method drives the async connect once
    }
}
