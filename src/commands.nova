// commands — MongoDB command builders (SRP: build the BSON documents that are the
// protocol's "commands", + read a command's error out of a reply). Each builder returns a
// BSON document ready for codec.encodeOpMsg. A "command" is just a BSON document,
// e.g. { find: "users", $db: "test" }.
import list;
import serde.bson;
import db;

pub fn newDoc(): bson.BsonDocument {
    return bson.BsonDocument{ entries: list.List<bson.BsonEntry>() };
}

/// { hello: 1, $db: <db> } — the connection handshake command.
pub fn helloCommand(dbName: string): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryInt("hello", 1));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

// Wrap one document as the single-element array { "0": <doc> } (BSON arrays are
// documents whose keys are the decimal indices).
fn singletonArray(doc: bson.BsonDocument): ptr {
    let arr = newDoc();
    arr.entries.push(bson.entryDoc("0", bson.serialize(doc)));
    return bson.serialize(arr);
}

/// { insert: <coll>, documents: [<doc>], $db: <db> }.
pub fn insertCommand(dbName: string, coll: string, doc: bson.BsonDocument): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("insert", coll));
    d.entries.push(bson.entryArray("documents", singletonArray(doc)));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { find: <coll>, filter: <filter>, $db: <db> }.
pub fn findCommand(dbName: string, coll: string, filter: bson.BsonDocument): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("find", coll));
    d.entries.push(bson.entryDoc("filter", bson.serialize(filter)));
    // Request a large first batch so the whole result comes back in `firstBatch` without a getMore
    // round-trip. MongoDB's default first batch is only 101 documents, which silently truncated any
    // larger collection (the driver reads firstBatch only; cursor draining via getMore is a follow-on).
    d.entries.push(bson.entryInt("batchSize", 100000));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// A full find with server-side filter/projection/sort/skip/limit + batchSize. Empty projection/sort
/// docs and skip/limit == 0 are omitted (their absence is the "unset" wire meaning).
pub fn findCommandFull(dbName: string, coll: string, filter: bson.BsonDocument, projection: bson.BsonDocument,
                       sort: bson.BsonDocument, skip: long, limit: long, batchSize: int): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("find", coll));
    d.entries.push(bson.entryDoc("filter", bson.serialize(filter)));
    if (projection.entries.size() > 0) { d.entries.push(bson.entryDoc("projection", bson.serialize(projection))); }
    if (sort.entries.size() > 0) { d.entries.push(bson.entryDoc("sort", bson.serialize(sort))); }
    if (skip > 0) { d.entries.push(bson.entryInt64Val("skip", skip)); }
    if (limit > 0) { d.entries.push(bson.entryInt64Val("limit", limit)); }
    d.entries.push(bson.entryInt("batchSize", batchSize));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { getMore: <cursorId int64>, collection: <coll>, batchSize, $db } — fetch the next cursor batch.
pub fn getMoreCommand(dbName: string, coll: string, cursorId: long, batchSize: int): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryInt64Val("getMore", cursorId));
    d.entries.push(bson.entryString("collection", coll));
    d.entries.push(bson.entryInt("batchSize", batchSize));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { killCursors: <coll>, cursors: [<cursorId int64>], $db } — release a not-yet-exhausted cursor.
pub fn killCursorsCommand(dbName: string, coll: string, cursorId: long): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("killCursors", coll));
    let arr = newDoc();
    arr.entries.push(bson.entryInt64Val("0", cursorId));
    d.entries.push(bson.entryArray("cursors", bson.serialize(arr)));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

// Build a BSON array document ("0","1",...) from a list of documents.
fn docArray(docs: List<bson.BsonDocument>): ptr {
    let arr = newDoc();
    let i = 0;
    while (i < docs.size()) { arr.entries.push(bson.entryDoc(`${i}`, bson.serialize(docs.get(i) ?? newDoc()))); i = i + 1; }
    return bson.serialize(arr);
}
// Wrap a single sub-document as a one-element BSON array.
fn oneDocArray(d: bson.BsonDocument): ptr {
    let arr = newDoc();
    arr.entries.push(bson.entryDoc("0", bson.serialize(d)));
    return bson.serialize(arr);
}

/// { insert: <coll>, documents: [<doc>...], ordered: true, $db } — one or more documents.
pub fn insertManyCommand(dbName: string, coll: string, docs: List<bson.BsonDocument>): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("insert", coll));
    d.entries.push(bson.entryArray("documents", docArray(docs)));
    d.entries.push(bson.entryBool("ordered", 1));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// bulkWrite building blocks (a single command carrying MANY specs). `insertManyCommandOrdered` is
/// insertManyCommand with an explicit ordered flag; the bulk update/delete commands take an array of
/// pre-built specs ({ q, u, upsert, multi } / { q, limit }).
pub fn insertManyCommandOrdered(dbName: string, coll: string, docs: List<bson.BsonDocument>, ordered: bool): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("insert", coll));
    d.entries.push(bson.entryArray("documents", docArray(docs)));
    d.entries.push(bson.entryBool("ordered", if (ordered) 1 else 0));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}
pub fn bulkUpdateCommand(dbName: string, coll: string, specs: List<bson.BsonDocument>, ordered: bool): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("update", coll));
    d.entries.push(bson.entryArray("updates", docArray(specs)));
    d.entries.push(bson.entryBool("ordered", if (ordered) 1 else 0));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}
/// The insert command BODY only (no `documents` array) -- the documents ride in a kind-1 OP_MSG
/// document sequence (codec.encodeOpMsgSeq). Wire-efficient for bulk: no array nested in the command.
pub fn insertBodyCommand(dbName: string, coll: string, ordered: bool): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("insert", coll));
    d.entries.push(bson.entryBool("ordered", if (ordered) 1 else 0));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

pub fn bulkDeleteCommand(dbName: string, coll: string, specs: List<bson.BsonDocument>, ordered: bool): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("delete", coll));
    d.entries.push(bson.entryArray("deletes", docArray(specs)));
    d.entries.push(bson.entryBool("ordered", if (ordered) 1 else 0));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { update: <coll>, updates: [{ q, u, upsert, multi }], $db }.
pub fn updateCommand(dbName: string, coll: string, filter: bson.BsonDocument, updateDoc: bson.BsonDocument,
                     upsert: bool, multi: bool): bson.BsonDocument {
    let u = newDoc();
    u.entries.push(bson.entryDoc("q", bson.serialize(filter)));
    u.entries.push(bson.entryDoc("u", bson.serialize(updateDoc)));
    u.entries.push(bson.entryBool("upsert", if (upsert) 1 else 0));
    u.entries.push(bson.entryBool("multi", if (multi) 1 else 0));
    let d = newDoc();
    d.entries.push(bson.entryString("update", coll));
    d.entries.push(bson.entryArray("updates", oneDocArray(u)));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { delete: <coll>, deletes: [{ q, limit }], $db }. limit 1 = one, 0 = all.
pub fn deleteCommand(dbName: string, coll: string, filter: bson.BsonDocument, limit: int): bson.BsonDocument {
    let del = newDoc();
    del.entries.push(bson.entryDoc("q", bson.serialize(filter)));
    del.entries.push(bson.entryInt("limit", limit));
    let d = newDoc();
    d.entries.push(bson.entryString("delete", coll));
    d.entries.push(bson.entryArray("deletes", oneDocArray(del)));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { findAndModify: <coll>, query, update, new, upsert, $db } — returns the pre- or post-image.
pub fn findAndModifyCommand(dbName: string, coll: string, filter: bson.BsonDocument, updateDoc: bson.BsonDocument,
                            returnNew: bool, upsert: bool): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("findAndModify", coll));
    d.entries.push(bson.entryDoc("query", bson.serialize(filter)));
    d.entries.push(bson.entryDoc("update", bson.serialize(updateDoc)));
    d.entries.push(bson.entryBool("new", if (returnNew) 1 else 0));
    d.entries.push(bson.entryBool("upsert", if (upsert) 1 else 0));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { aggregate: <coll>, pipeline: [<stage>...], cursor: { batchSize }, $db }.
pub fn aggregateCommand(dbName: string, coll: string, pipeline: List<bson.BsonDocument>, batchSize: int): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("aggregate", coll));
    d.entries.push(bson.entryArray("pipeline", docArray(pipeline)));
    let cur = newDoc();
    cur.entries.push(bson.entryInt("batchSize", batchSize));
    d.entries.push(bson.entryDoc("cursor", bson.serialize(cur)));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { count: <coll>, query: <filter>, $db } — a fast metadata count (query omitted = whole collection).
pub fn countCommand(dbName: string, coll: string, filter: bson.BsonDocument): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("count", coll));
    if (filter.entries.size() > 0) { d.entries.push(bson.entryDoc("query", bson.serialize(filter))); }
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { distinct: <coll>, key: <field>, query: <filter>, $db }.
pub fn distinctCommand(dbName: string, coll: string, key: string, filter: bson.BsonDocument): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("distinct", coll));
    d.entries.push(bson.entryString("key", key));
    if (filter.entries.size() > 0) { d.entries.push(bson.entryDoc("query", bson.serialize(filter))); }
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { createIndexes: <coll>, indexes: [{ key, name, unique? }], $db }.
pub fn createIndexCommand(dbName: string, coll: string, keys: bson.BsonDocument, name: string, unique: bool): bson.BsonDocument {
    let idx = newDoc();
    idx.entries.push(bson.entryDoc("key", bson.serialize(keys)));
    idx.entries.push(bson.entryString("name", name));
    if (unique) { idx.entries.push(bson.entryBool("unique", 1)); }
    let d = newDoc();
    d.entries.push(bson.entryString("createIndexes", coll));
    d.entries.push(bson.entryArray("indexes", oneDocArray(idx)));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { dropIndexes: <coll>, index: <name>, $db }.
pub fn dropIndexCommand(dbName: string, coll: string, name: string): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryString("dropIndexes", coll));
    d.entries.push(bson.entryString("index", name));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { startSession: 1, $db: "admin" } — the server returns { id: { id: <uuid binary> } }.
pub fn startSessionCommand(): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryInt("startSession", 1));
    d.entries.push(bson.entryString("$db", "admin"));
    return d;
}
/// { commitTransaction: 1, lsid, txnNumber, autocommit: false, $db: "admin" }. `lsid` is the raw
/// serialized `{ id: <binary> }` sub-document bytes returned by startSession.
pub fn commitTxnCommand(lsid: string, txnNumber: long): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryInt("commitTransaction", 1));
    d.entries.push(bson.entryDoc("lsid", lsid));
    d.entries.push(bson.entryInt64Val("txnNumber", txnNumber));
    d.entries.push(bson.entryBool("autocommit", 0));
    d.entries.push(bson.entryString("$db", "admin"));
    return d;
}
/// { abortTransaction: 1, lsid, txnNumber, autocommit: false, $db: "admin" }.
pub fn abortTxnCommand(lsid: string, txnNumber: long): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryInt("abortTransaction", 1));
    d.entries.push(bson.entryDoc("lsid", lsid));
    d.entries.push(bson.entryInt64Val("txnNumber", txnNumber));
    d.entries.push(bson.entryBool("autocommit", 0));
    d.entries.push(bson.entryString("$db", "admin"));
    return d;
}

// Map a MongoDB error code onto the normalized db.DBERR_* taxonomy.
pub fn classifyMongoErr(code: int): int {
    if (code == 11000 || code == 11001) { return db.DBERR_UNIQUE_VIOLATION; }  // duplicate key
    if (code == 121) { return db.DBERR_CHECK; }                                // document validation
    if (code == 50) { return db.DBERR_LOCK_TIMEOUT; }                          // MaxTimeMSExpired
    if (code == 13 || code == 18) { return db.DBERR_AUTH; }                    // Unauthorized / AuthFailed
    return db.DBERR_UNKNOWN;
}

// The first per-document write error (writeErrors: [{index, code, errmsg}]) from a write reply,
// classified onto DBERR_*. Falls back to the command-level error when there is no writeErrors array.
pub fn writeError(reply: bson.BsonDocument): DbError {
    let weIdx = bson.docFind(reply, "writeErrors");
    if (weIdx < 0) { return commandError(reply); }
    let arr = bson.deserialize(bson.docGetArray(reply, weIdx) as ptr);
    if (arr.entries.size() == 0) { return commandError(reply); }
    let e0 = bson.deserialize(bson.docGetDoc(arr, 0) as ptr);
    let cIdx = bson.docFind(e0, "code");
    let mIdx = bson.docFind(e0, "errmsg");
    let code = if (cIdx >= 0) bson.docGetInt(e0, cIdx) else 0;
    let msg = if (mIdx >= 0) bson.docGetString(e0, mIdx) else "write error";
    return DbError(`${code}`, msg).with(code, classifyMongoErr(code));
}

/// { saslStart: 1, mechanism: "SCRAM-SHA-256", payload: <bin>, $db: <db> }.
pub fn saslStartCommand(dbName: string, clientFirst: string): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryInt("saslStart", 1));
    d.entries.push(bson.entryString("mechanism", "SCRAM-SHA-256"));
    d.entries.push(bson.entryBinary("payload", clientFirst));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

/// { saslContinue: 1, conversationId: <id>, payload: <bin>, $db: <db> }.
pub fn saslContinueCommand(dbName: string, conversationId: int, clientFinal: string): bson.BsonDocument {
    let d = newDoc();
    d.entries.push(bson.entryInt("saslContinue", 1));
    d.entries.push(bson.entryInt("conversationId", conversationId));
    d.entries.push(bson.entryBinary("payload", clientFinal));
    d.entries.push(bson.entryString("$db", dbName));
    return d;
}

// A failed MongoDB command replies with { ok: 0.0, errmsg: string, code: int }; a success has no
// errmsg. BSON has no double accessor here, so presence of `errmsg` is the reliable failure signal.
pub fn commandError(reply: bson.BsonDocument): DbError {
    let emIdx = bson.docFind(reply, "errmsg");
    if (emIdx < 0) { return noError(); }
    let msg = bson.docGetString(reply, emIdx);
    let codeIdx = bson.docFind(reply, "code");
    let codeN = if (codeIdx >= 0) bson.docGetInt(reply, codeIdx) else 0;
    return DbError(`${codeN}`, msg).with(codeN, classifyMongoErr(codeN));
}
